import dns from 'dns/promises';
import net from 'net';
import tls from 'tls';
import axios from 'axios';
import * as cheerio from 'cheerio';
import { URL } from 'url';

// ═══════════════════════════════════════════════════
// PHASE 1: Subdomain Enumeration (Multiple Sources)
// ═══════════════════════════════════════════════════

export async function getSubdomains(domain) {
    const allSubs = new Set();

    // Source 1: crt.sh (Certificate Transparency)
    try {
        const res = await axios.get(`https://crt.sh/?q=%.${domain}&output=json`, {
            timeout: 15000,
            headers: { 'User-Agent': 'Mozilla/5.0 BugFinder/1.0' }
        });
        if (res.data && Array.isArray(res.data)) {
            res.data.forEach(entry => {
                const name = entry.name_value;
                if (!name || name.includes('*')) return;
                name.split('\n').forEach(sub => {
                    const cleaned = sub.trim().toLowerCase();
                    if (cleaned.endsWith(domain) && !cleaned.includes('*')) {
                        allSubs.add(cleaned);
                    }
                });
            });
        }
    } catch (err) {
        console.error(`[crt.sh] Failed for ${domain}:`, err.message);
    }

    // Source 2: HackerTarget subdomain finder
    try {
        const res = await axios.get(`https://api.hackertarget.com/hostsearch/?q=${domain}`, {
            timeout: 10000
        });
        if (res.data && typeof res.data === 'string' && !res.data.includes('error')) {
            res.data.split('\n').forEach(line => {
                const sub = line.split(',')[0]?.trim().toLowerCase();
                if (sub && sub.endsWith(domain)) allSubs.add(sub);
            });
        }
    } catch (err) {
        console.error(`[HackerTarget] Failed for ${domain}:`, err.message);
    }

    // Source 3: RapidDNS
    try {
        const res = await axios.get(`https://rapiddns.io/subdomain/${domain}?full=1`, {
            timeout: 10000,
            headers: { 'User-Agent': 'Mozilla/5.0' }
        });
        if (res.data) {
            const $ = cheerio.load(res.data);
            $('td').each((_, el) => {
                const text = $(el).text().trim().toLowerCase();
                if (text.endsWith(domain) && text.includes('.') && !text.includes(' ')) {
                    allSubs.add(text);
                }
            });
        }
    } catch (err) {
        console.error(`[RapidDNS] Failed for ${domain}:`, err.message);
    }

    // Source 4: DNS common prefixes brute-force
    const commonPrefixes = [
        'www', 'mail', 'ftp', 'smtp', 'pop', 'imap', 'webmail', 'ns1', 'ns2',
        'api', 'dev', 'staging', 'test', 'beta', 'admin', 'portal', 'vpn',
        'remote', 'gateway', 'secure', 'login', 'app', 'blog', 'shop',
        'store', 'cdn', 'static', 'assets', 'media', 'img', 'images',
        'docs', 'help', 'support', 'status', 'monitor', 'dashboard',
        'm', 'mobile', 'auth', 'sso', 'oauth', 'git', 'gitlab', 'jenkins',
        'ci', 'jira', 'confluence', 'wiki', 'intranet', 'internal',
        'db', 'database', 'mysql', 'postgres', 'redis', 'mongo',
        'backup', 'bk', 'old', 'new', 'v2', 'v3', 'sandbox',
        'demo', 'preview', 'stage', 'uat', 'qa', 'prod',
        'cpanel', 'plesk', 'whm', 'webdisk', 'autodiscover',
        'mx', 'mx1', 'mx2', 'relay', 'email', 'newsletter',
        'cloud', 'aws', 'gcp', 'azure', 's3', 'storage'
    ];

    const dnsChecks = commonPrefixes.map(async (prefix) => {
        const sub = `${prefix}.${domain}`;
        try {
            const result = await dns.resolve4(sub);
            if (result && result.length > 0) allSubs.add(sub);
        } catch (e) { /* doesn't resolve */ }
    });
    await Promise.allSettled(dnsChecks);

    // Always include root domain
    allSubs.add(domain);

    return Array.from(allSubs).sort();
}

